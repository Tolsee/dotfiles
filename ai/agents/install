#!/bin/bash
# Wire the shared agent rules into each agent's global config.
#
# - Claude Code: ~/.claude/CLAUDE.md + RTK.md are symlinks into dotfiles/ai/claude/
#   (CLAUDE.md @-imports ai/agents/AGENTS.md, so plugin edits stay tracked in git).
# - Codex / Gemini: their global files are NOT symlinked — codex's is
#   tool-managed (ltd-skill) and gemini appends memories to its file — so we
#   only ensure a pointer/import line exists.
set -euo pipefail

DOTFILES="$(cd "$(dirname "$0")/../.." && pwd)"
SHARED="$DOTFILES/ai/agents/AGENTS.md"

# Match the MCP installer's agent selection; no arguments still installs all.
agents=()
if [ "$#" -gt 0 ]; then
  agents=("$@")
else
  read -r -a agents <<< "${AGENTS:-claude-code antigravity codex}"
fi
for agent in "${agents[@]}"; do
  case "$agent" in
    claude-code|antigravity|codex|pi|devin) ;;
    *) echo "Unsupported agent target: $agent" >&2; exit 1 ;;
  esac
done

selected() {
  local agent
  for agent in "${agents[@]}"; do
    [ "$agent" != "$1" ] || return 0
  done
  return 1
}

# Claude Code
if selected claude-code; then
  mkdir -p ~/.claude ~/.claude/skills
  for f in CLAUDE.md RTK.md; do
    ln -sf "$DOTFILES/ai/claude/$f" ~/.claude/"$f"
  done
  echo "linked ~/.claude/{CLAUDE.md,RTK.md} -> $DOTFILES/ai/claude/"

  # settings.json is NOT symlinked: it holds private/machine-specific entries
  # (marketplaces, plugins, paths). Deep-merge tracked defaults into the local
  # file; local values win, and arrays are not unioned (a local array wins whole).
  settings=~/.claude/settings.json
  [ -s "$settings" ] || echo '{}' > "$settings"
  tmp="$(mktemp)"
  jq -s '.[0] * .[1]' "$DOTFILES/ai/claude/settings.defaults.json" "$settings" > "$tmp"
  mv "$tmp" "$settings"  # also replaces a legacy symlink with a real file
  echo "merged $DOTFILES/ai/claude/settings.defaults.json into $settings"

  # Claude Code — global subagent definitions (model-tiered by task complexity)
  ln -sfn "$DOTFILES/ai/claude/agents" ~/.claude/agents
  echo "linked ~/.claude/agents -> $DOTFILES/ai/claude/agents"

  # Claude Code — Claude-only skills (NOT installed for codex/antigravity, so they
  # live here with --agent claude-code rather than in ai/skills/, which targets all
  # agents). The skills CLI only recognizes SKILL.md-based skills (copies into
  # ~/.agents/skills, so re-run after edits); function-hooks plugins (a
  # .claude-plugin/plugin.json + hooks/ dir, no SKILL.md) are invisible to it and
  # are symlinked directly below instead, matching how Claude Code auto-loads a
  # plugin dropped under ~/.claude/skills/<name>.
  if [ -d "$DOTFILES/ai/claude/skills" ]; then
    echo "Installing Claude-only skills..."
    npx -y skills@latest add "$DOTFILES/ai/claude/skills" \
      --skill '*' \
      --agent claude-code \
      --global \
      --yes

    for mod in "$DOTFILES"/ai/claude/skills/*/; do
      mod="${mod%/}"
      [ -f "$mod/.claude-plugin/plugin.json" ] || continue
      name="$(basename "$mod")"
      ln -sfn "$mod" ~/.claude/skills/"$name"
      echo "linked ~/.claude/skills/$name -> $mod"
    done
  fi

fi

# Codex — append pointers if missing
if selected codex && [ -e ~/.codex ]; then
  if grep -q "dotfiles/agents/AGENTS.md" ~/.codex/AGENTS.md 2>/dev/null; then
    perl -0pi -e 's#dotfiles/agents/AGENTS\.md#dotfiles/ai/agents/AGENTS.md#g' ~/.codex/AGENTS.md
    echo "migrated pointer in ~/.codex/AGENTS.md"
  elif ! grep -q "dotfiles/ai/agents/AGENTS.md" ~/.codex/AGENTS.md 2>/dev/null; then
    printf '\n## Global Rules\n\nAlso read and follow %s (shared rules for all coding agents).\n' "$SHARED" >> ~/.codex/AGENTS.md
    echo "added pointer to ~/.codex/AGENTS.md"
  fi
  if ! grep -Fq "$DOTFILES/ai/codex/AGENTS.md" ~/.codex/AGENTS.md 2>/dev/null; then
    printf '\n## Codex Rules\n\nAlso read and follow %s (Codex-specific rules).\n' "$DOTFILES/ai/codex/AGENTS.md" >> ~/.codex/AGENTS.md
    echo "added Codex-specific pointer to ~/.codex/AGENTS.md"
  fi
fi

# Gemini / Antigravity — append import if missing
if selected antigravity && [ -e ~/.gemini ]; then
  if grep -q "dotfiles/agents/AGENTS.md" ~/.gemini/GEMINI.md 2>/dev/null; then
    perl -0pi -e 's#dotfiles/agents/AGENTS\.md#dotfiles/ai/agents/AGENTS.md#g' ~/.gemini/GEMINI.md
    echo "migrated import in ~/.gemini/GEMINI.md"
  elif ! grep -q "dotfiles/ai/agents/AGENTS.md" ~/.gemini/GEMINI.md 2>/dev/null; then
    printf '\n@%s\n' "$SHARED" >> ~/.gemini/GEMINI.md
    echo "added import to ~/.gemini/GEMINI.md"
  fi
fi

# Pi is opt-in; its shared skills are discovered from ~/.agents/skills.
if selected pi; then
  pi_agent_dir=$(python3 -c 'import os; print(os.path.expanduser(os.environ.get("PI_CODING_AGENT_DIR") or "~/.pi/agent"))')
  pi_rules="$pi_agent_dir/AGENTS.md"
  mkdir -p "$pi_agent_dir"
  if [[ -e "$pi_rules" || -L "$pi_rules" ]]; then
    if [[ ! -L "$pi_rules" || "$(readlink "$pi_rules")" != "$DOTFILES/ai/pi/AGENTS.md" ]]; then
      echo "Refusing to replace existing Pi instructions: $pi_rules" >&2
      exit 1
    fi
  else
    ln -s "$DOTFILES/ai/pi/AGENTS.md" "$pi_rules"
  fi
fi

# Devin CLI reads its own global AGENTS.md in addition to imported Claude rules.
if selected devin; then
  devin_dir="${XDG_CONFIG_HOME:-$HOME/.config}/devin"
  mkdir -p "$devin_dir"
  if ! grep -Fq "$SHARED" "$devin_dir/AGENTS.md" 2>/dev/null; then
    printf '\n## Global Rules\n\nRead and follow %s.\n' "$SHARED" >> "$devin_dir/AGENTS.md"
  fi
fi

echo "done"
