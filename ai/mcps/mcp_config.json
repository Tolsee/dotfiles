{
  "mcpServers": {
    "buildkite": {
      "type": "http",
      "url": "https://mcp.buildkite.com/mcp/readonly"
    },
    "aws-mcp": {
      "command": "python3",
      "args": [
        "$HOME/dev/dotfiles/ai/aws/access.py",
        "mcp"
      ],
      "env_vars": [
        "AWS_CONFIG_FILE",
        "AWS_VAULT_BACKEND",
        "AWS_VAULT_KEYCHAIN_NAME",
        "AWS_AGENT_SETTINGS",
        "XDG_CONFIG_HOME"
      ]
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "datadog-mcp": {
      "type": "http",
      "url": "https://mcp.datadoghq.com/v1/mcp"
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "grafana": {
      "command": "sh",
      "args": [
        "-c",
        "docker run --rm -i -v /Users/tolsee/.ltd/proxy/certificates:/certs:ro -e GRAFANA_URL -e GRAFANA_SERVICE_ACCOUNT_TOKEN grafana/mcp-grafana -t stdio --tls-cert-file /certs/mtls-cert.pem --tls-key-file /certs/mtls-key.pem"
      ],
      "env": {
        "GRAFANA_URL": "https://grafana.platform.linktr.ee"
      },
      "env_vars": [
        "GRAFANA_SERVICE_ACCOUNT_TOKEN"
      ]
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "postme": {
      "type": "http",
      "url": "https://postme.live/api/mcp",
      "headers": {
        "Authorization": "Bearer $POSTME_API_KEY"
      },
      "bearer_token_env_var": "POSTME_API_KEY"
    }
  }
}
