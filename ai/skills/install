#!/bin/bash
# Install repo-owned and selected upstream skills into agent skill dirs via the
# vercel-labs `skills` CLI.
#
# Usage:
#   ./ai/skills/install                 # default agents
#   ./ai/skills/install cursor amp      # override agents
#   AGENTS="claude-code codex" ./ai/skills/install
set -euo pipefail

SKILLS_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SKILLS_DIR"

# shellcheck source=upstream-skills
source "$SKILLS_DIR/upstream-skills"

# Default agents. Override via args or $AGENTS.
if [ "$#" -gt 0 ]; then
  SELECTED_AGENTS=("$@")
elif [ -n "${AGENTS:-}" ]; then
  read -r -a SELECTED_AGENTS <<< "$AGENTS"
else
  SELECTED_AGENTS=(claude-code codex antigravity devin cursor)
fi

echo "Installing local skills from $PWD -> agents: ${SELECTED_AGENTS[*]}"
npx -y skills@latest add . \
  --skill '*' \
  --agent "${SELECTED_AGENTS[@]}" \
  --global \
  --yes

echo "Installing selected skills from mattpocock/skills -> agents: ${SELECTED_AGENTS[*]}"
npx -y skills@latest add mattpocock/skills \
  --skill "${MATTPOCOCK_SKILLS[@]}" \
  --agent "${SELECTED_AGENTS[@]}" \
  --global \
  --yes

echo "Installing selected skills from herdrdev/herdr -> agents: ${SELECTED_AGENTS[*]}"
npx -y skills@latest add herdrdev/herdr \
  --skill "${HERDR_SKILLS[@]}" \
  --agent "${SELECTED_AGENTS[@]}" \
  --global \
  --yes

# Claude Code already has this skill via the typesafe@typesafe-ai plugin.
NON_CLAUDE_AGENTS=()
for agent in "${SELECTED_AGENTS[@]}"; do
  [ "$agent" = claude-code ] || NON_CLAUDE_AGENTS+=("$agent")
done
if [ "${#NON_CLAUDE_AGENTS[@]}" -gt 0 ]; then
  echo "Installing selected skills from typesafe-ai/skills -> agents: ${NON_CLAUDE_AGENTS[*]}"
  npx -y skills@latest add typesafe-ai/skills \
    --skill "${TYPESAFE_SKILLS[@]}" \
    --agent "${NON_CLAUDE_AGENTS[@]}" \
    --global \
    --yes
fi

# The skills CLI currently skips these agents' global discovery directories.
for agent in "${SELECTED_AGENTS[@]}"; do
  case "$agent" in
    antigravity) target_dir="$HOME/.gemini/antigravity/skills" ;;
    cursor) target_dir="$HOME/.cursor/skills" ;;
    *) continue ;;
  esac
  mkdir -p "$target_dir"
  for skill in "${HERDR_SKILLS[@]}" "${TYPESAFE_SKILLS[@]}"; do
    if [ ! -e "$target_dir/$skill" ] && [ ! -L "$target_dir/$skill" ]; then
      ln -s "$HOME/.agents/skills/$skill" "$target_dir/$skill"
    fi
    test -f "$target_dir/$skill/SKILL.md"
  done
done
