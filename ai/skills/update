#!/bin/bash
# Update globally installed upstream skills managed by the `skills` CLI
# (codex, antigravity, ...). Pass skill names to update a subset.
#
# Claude Code's upstream skills come from the mattpocock-skills plugin, which
# updates automatically via the official marketplace.
#
# Local skills follow this repository and are refreshed by re-running
# ./ai/skills/install.
set -euo pipefail

echo "Updating upstream skills globally: ${*:-all}"
npx -y skills@latest update "$@" --global --yes
