#!/bin/bash
# Install Spotify Portal using native plugins where supported, skills elsewhere.
set -euo pipefail

PORTAL_SOURCE=spotify/portal-ai-plugins
PORTAL_SKILLS=(setup doctor search service actions feedback)

command -v jq >/dev/null 2>&1 || { echo "jq is required to inspect plugin marketplaces." >&2; exit 1; }

if [ "$#" -gt 0 ]; then
  SELECTED_AGENTS=("$@")
elif [ -n "${AGENTS:-}" ]; then
  read -r -a SELECTED_AGENTS <<< "$AGENTS"
else
  SELECTED_AGENTS=(claude-code codex antigravity)
  for agent in devin cursor; do
    if command -v "$agent" >/dev/null 2>&1; then
      SELECTED_AGENTS+=("$agent")
    fi
  done
fi

FALLBACK_AGENTS=()
for agent in "${SELECTED_AGENTS[@]}"; do
  echo "Installing Spotify Portal for $agent..."
  case "$agent" in
    claude-code)
      if ! command -v claude >/dev/null 2>&1; then
        FALLBACK_AGENTS+=("$agent")
        continue
      fi
      marketplaces="$(claude plugin marketplace list --json)"
      if ! jq -e 'any(.[]; .name == "portal")' <<< "$marketplaces" >/dev/null; then
        claude plugin marketplace add "$PORTAL_SOURCE" --scope user
      fi
      claude plugin install portal@portal --scope user
      ;;
    codex)
      if ! command -v codex >/dev/null 2>&1; then
        FALLBACK_AGENTS+=("$agent")
        continue
      fi
      marketplaces="$(codex plugin marketplace list --json)"
      if ! jq -e 'any(.marketplaces[]; .name == "portal")' <<< "$marketplaces" >/dev/null; then
        codex plugin marketplace add "$PORTAL_SOURCE"
      fi
      codex plugin add portal@portal
      ;;
    devin)
      devin plugins install "$PORTAL_SOURCE" --yes --local
      ;;
    *)
      FALLBACK_AGENTS+=("$agent")
      ;;
  esac
done

if [ "${#FALLBACK_AGENTS[@]}" -gt 0 ]; then
  npx -y skills@latest add "$PORTAL_SOURCE" \
    --skill "${PORTAL_SKILLS[@]}" \
    --agent "${FALLBACK_AGENTS[@]}" \
    --global \
    --yes

  # The skills CLI treats these agents as universal and currently only writes
  # ~/.agents/skills, even with --copy. Keep their global discovery paths wired.
  for agent in "${FALLBACK_AGENTS[@]}"; do
    case "$agent" in
      antigravity) target_dir="$HOME/.gemini/antigravity/skills" ;;
      cursor) target_dir="$HOME/.cursor/skills" ;;
      *) continue ;;
    esac
    mkdir -p "$target_dir"
    for skill in "${PORTAL_SKILLS[@]}"; do
      source_dir="$HOME/.agents/skills/$skill"
      target="$target_dir/$skill"
      if [ -L "$target" ] && [ "$(readlink "$target")" = "$source_dir" ]; then
        continue
      fi
      if [ -e "$target" ] || [ -L "$target" ]; then
        echo "Cannot link $target: an existing skill occupies that path." >&2
        exit 1
      fi
      test -f "$source_dir/SKILL.md"
      ln -s "$source_dir" "$target"
    done
  done
fi

echo "Spotify Portal installed. Start a new agent session and ask to set up Spotify Portal."
