#!/usr/bin/env bash
# One line for Herdr's tab bar (ui.tab_bar_right), in GitHub's own Octicons (Nerd Font):
# agents waiting for you across the session, then the focused pane's branch PR with its
# review and CI state, e.g.  (alert) 2 blocked · (draft PR) #123 · (diff) changes · (x) CI
# Herdr runs it on the server with the active pane's context, keeps only the last line and
# strips escape sequences, so no colour and no clickable links: prefix+o opens the PR.
# Every lookup degrades to printing less, never an error.

set -uo pipefail
export PATH="$HOME/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
command -v jq >/dev/null 2>&1 || exit 0
herdr_bin=${HERDR_BIN_PATH:-$(command -v herdr || true)}
[[ -n "$herdr_bin" ]] || exit 0

# Nerd Font Octicons as raw UTF-8 bytes (no \u in macOS bash 3.2 or a C locale).
i_alert=$(printf '\357\220\241')     # nf-oct-alert
i_pr=$(printf '\357\220\207')        # nf-oct-git_pull_request
i_draft=$(printf '\357\223\235')     # nf-oct-git_pull_request_draft
i_merged=$(printf '\357\220\231')    # nf-oct-git_merge
i_closed=$(printf '\357\223\234')    # nf-oct-git_pull_request_closed
i_approved=$(printf '\357\222\236')  # nf-oct-check_circle
i_changes=$(printf '\357\223\222')   # nf-oct-file_diff
i_review=$(printf '\357\221\201')    # nf-oct-eye
i_ok=$(printf '\357\220\256')        # nf-oct-check
i_fail=$(printf '\357\221\247')      # nf-oct-x
i_pending=$(printf '\357\221\204')   # nf-oct-dot_fill

parts=()

blocked=$("$herdr_bin" pane list 2>/dev/null | jq '[.result.panes[]? | select(.agent_status == "blocked")] | length' 2>/dev/null)
[[ "${blocked:-0}" =~ ^[1-9] ]] && parts+=("$i_alert $blocked blocked")

# The focused pane's checkout: the calling context's pane, else the focused one.
pane=${HERDR_PANE_ID:-}
if [[ -z "$pane" ]]; then
    ws=$("$herdr_bin" workspace list 2>/dev/null | jq -r '.result.workspaces[]? | select(.focused) | .workspace_id' 2>/dev/null | head -n1)
    [[ -n "$ws" ]] && pane=$("$herdr_bin" pane list --workspace "$ws" 2>/dev/null | jq -r '[.result.panes[]? | select(.focused)][0].pane_id // empty' 2>/dev/null)
fi
cwd=""
[[ -n "$pane" ]] && cwd=$("$herdr_bin" pane get "$pane" 2>/dev/null | jq -r '.result.pane.foreground_cwd // .result.pane.cwd // empty' 2>/dev/null)
cwd=${cwd:-$PWD}

repo=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)
branch=""
[[ -n "$repo" ]] && branch=$(git -C "$repo" symbolic-ref --short -q HEAD 2>/dev/null)
base=""
[[ -n "$repo" ]] && base=$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')

if [[ -n "$branch" && "$branch" != "${base:-main}" ]] && command -v gh >/dev/null 2>&1; then
    pr=$(cd "$repo" && gh pr view "$branch" --json number,state,isDraft,reviewDecision,statusCheckRollup 2>/dev/null)
    if [[ -z "$pr" ]]; then
        parts+=("$i_pr no PR")
    else
        parts+=("$(jq -r \
            --arg pr "$i_pr" --arg draft "$i_draft" --arg merged "$i_merged" --arg closed "$i_closed" \
            --arg approved "$i_approved" --arg changes "$i_changes" --arg review "$i_review" \
            --arg ok "$i_ok" --arg fail "$i_fail" --arg pending "$i_pending" '
            def check_state:
                if (.conclusion // "") != "" then .conclusion
                elif (.state // "") != "" then .state
                else (.status // "") end | ascii_upcase;
            [.statusCheckRollup[]? | check_state] as $s
            | [
                (if .state == "MERGED" then $merged elif .state == "CLOSED" then $closed
                 elif .isDraft then $draft else $pr end) + " #\(.number)",
                (if .state != "OPEN" then empty
                 else
                    ({"APPROVED": "\($approved) approved", "CHANGES_REQUESTED": "\($changes) changes",
                      "REVIEW_REQUIRED": "\($review) review"}[.reviewDecision // ""] // empty)
                 end),
                (if .state != "OPEN" or ($s | length) == 0 then empty
                 elif any($s[]; IN("FAILURE", "ERROR", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE")) then "\($fail) CI"
                 elif any($s[]; IN("SUCCESS", "NEUTRAL", "SKIPPED") | not) then "\($pending) CI"
                 else "\($ok) CI" end)
              ] | join(" · ")' <<<"$pr" 2>/dev/null)")
    fi
fi

[[ ${#parts[@]} -gt 0 ]] || exit 0
out=${parts[0]}
for part in "${parts[@]:1}"; do
    [[ -n "$part" ]] && out="$out · $part"
done
printf '%s\n' "$out"
