#!/usr/bin/env bash
# Start a ticket in its own Herdr worktree workspace, or prune finished ones.
#
#   herdr-task start <ticket> [options]   <ticket> is a Linear issue link, an issue id such
#                                         as ABC-123, or a plain branch name. Creates (or
#                                         reopens) a worktree workspace for it, tags the
#                                         workspace with the ticket for the sidebar, and
#                                         starts an agent there with the ticket as its
#                                         first prompt.
#       -p, --project DIR     repository to branch from (default: the current repository)
#       -t, --title TEXT      ticket title, used for the workspace label
#       -u, --url URL         ticket link, when <ticket> is a bare id
#       -a, --agent KIND      agent to start in the new workspace (default: $HERDR_TASK_AGENT
#                             or claude); "none" leaves a shell
#       --prompt TEXT         first prompt for the agent (default: work on the ticket)
#   herdr-task prune [DIR]                remove worktree workspaces whose branch has merged
#   herdr-task prune-worktree PATH        the same check for one worktree, removed without
#                                         asking; run by the worktree-cleanup plugin when its
#                                         workspace closes
#   herdr-task open [PANE]                open the focused (or given) pane's ticket or PR in the
#                                         browser, with a picker when there are several
#   herdr-task branch <ticket>            print the branch name a ticket would get
#   herdr-task tag <ticket> [-t TITLE]    tag the current workspace with a ticket created
#                                         after the work started: sidebar, label, and the
#                                         branch renamed to carry the id if not pushed yet
#   herdr-task                            interactive (prefix+t): a ticket link or id, a branch
#                                         name, or free text describing the task ("fix flaky
#                                         login test" becomes the title, the first prompt and a
#                                         slug branch); suggested from the clipboard, project
#                                         guessed from the ticket's team or the focused
#                                         workspace; agent started in the background so the
#                                         popup closes at once
#   herdr-task retag [--startup] [--workspace W]
#                                         put back the ticket, repo and agent labels Herdr
#                                         forgets on a server restart (it keeps no metadata
#                                         tokens), from what start and tag saved on the branch;
#                                         run by the task plugin at startup and when a worktree
#                                         opens
#   herdr-task open-ticket <url>          Ctrl-click on a Linear link: focus the workspace of
#                                         that ticket's task, else open the link in the browser
#   herdr-task review [options]           (prefix+y) open reviewer splits beside the pane: Codex
#                                         (~/.codex-review/codex-review) and a Claude agent told
#                                         not to edit, both on the branch diff against its base
#       --with codex|claude|both  reviewers (default: $HERDR_TASK_REVIEWERS or both)
#       --base BRANCH             base branch (default: origin's default branch)
#       --pane PANE               task pane (default: this pane, else the focused one)
#   herdr-task ship [--pane PANE]         (prefix+u) ask the task's agent to ship (review, push,
#                                         open the PR, babysit); with no agent in the workspace,
#                                         push the branch and open a draft PR directly
#   herdr-task projects [--cwd DIR]       Herdr app (task mods), JSON, no herdr server: the
#                                         repositories under the roots, the focused one first
#   herdr-task parse <ref> [--cwd DIR]    what <ref> would start: kind, ticket, branch, title,
#                                         projects with the best guess first (prefix+t preview)
#   herdr-task prepare <ref> --project DIR [--title T] [--agent KIND]
#                                         the worktree and saved ticket for <ref>; prints the
#                                         path, space label and agent prompt for the mod
#   herdr-task review-plan --cwd DIR      prefix+y in the app: the task's repo, branch, base,
#                                         reviewer prompt and Codex review command
#   herdr-task ship-prompt                what prefix+u tells the task's agent
#   herdr-task ship-direct --cwd DIR      prefix+u in the app with no agent: push, draft PR
#   herdr-task prunable --cwd DIR         prune's verdict for each worktree of DIR's repository
#   herdr-task prune-remove --cwd DIR PATH...
#                                         remove those worktrees (open PRs re-checked)
#   herdr-task open-file <url> [--pane P] open a file:// link in $EDITOR in a split beside the
#                                         pane, at the line the link carries (#L12 or :12)
#
# HERDR_TASK_PROJECT_ROOTS (colon separated, private shell config) lists directories to scan
# for repositories in the interactive project picker. As plugin actions (dotfiles.task),
# review, ship and open-file report through Herdr notifications instead of stderr.

set -euo pipefail

# Nerd Font glyphs as raw UTF-8 bytes: \u escapes come out as literal text in a C locale,
# which is what herdr popups run in. U+F41B nf-oct-issue_opened (Nerd Fonts ships no Linear
# logo), U+EC82 nf-cod-claude, U+EC81 nf-cod-openai, U+EC20 nf-cod-robot.
linear_glyph=$(printf '\356\206\260')  # U+E1B0, Linear logo from herdr/fonts/HerdrTaskIcons

# Sidebar label per agent kind.
agent_label() {
    case "$1" in
        claude) printf '\356\262\202 claude' ;;
        codex) printf '\356\262\201 codex' ;;
        *) printf '\356\260\240 %s' "$1" ;;
    esac
}
metadata_source="herdr-task"
# Popups start zsh without .zshrc, so pick up the shared vim-mode fzf defaults here.
if [[ -z "${FZF_DEFAULT_OPTS_FILE:-}" && -f "$HOME/.config/fzf/fzfrc" ]]; then
    export FZF_DEFAULT_OPTS_FILE="$HOME/.config/fzf/fzfrc"
fi
project_roots="${HERDR_TASK_PROJECT_ROOTS:-}"
default_agent="${HERDR_TASK_AGENT:-claude}"
# Where prepare puts worktrees: the TUI's [worktrees] directory and the app's worktree mod.
worktrees_dir="${HERDR_TASK_WORKTREES:-$HOME/.herdr/worktrees}"

# detach <cmd...>: run a command in its own session so it survives the popup pane
# closing. A closing pane kills its process group, which nohup alone does not escape;
# macOS has no setsid binary, so use Python's.
detach() {
    local log="${XDG_CACHE_HOME:-$HOME/.cache}/herdr-task/detach.log"
    mkdir -p "${log%/*}"
    printf '%s detach: %s\n' "$(date '+%F %T')" "$*" >> "$log"
    if command -v python3 >/dev/null 2>&1; then
        # Daemonize: double fork so the starter is never a child of the popup, a new session
        # so it has no controlling terminal, and every inherited descriptor closed so it does
        # not keep the popup's pty open (Herdr reaps what still holds a closed pane's pty).
        python3 - "$log" "$@" <<'PY'
import os, sys
log, argv = sys.argv[1], sys.argv[2:]
if os.fork():
    sys.exit(0)
os.setsid()
if os.fork():
    os._exit(0)
os.chdir(os.environ.get("HOME", "/"))
fd_in = os.open(os.devnull, os.O_RDONLY)
fd_out = os.open(log, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
os.dup2(fd_in, 0); os.dup2(fd_out, 1); os.dup2(fd_out, 2)
os.closerange(3, 4096)
os.execvp(argv[0], argv)
PY
    else
        nohup "$@" </dev/null >>"$log" 2>&1 &
        disown 2>/dev/null || true
    fi
}

die() { printf 'herdr-task: %s\n' "$*" >&2; exit 1; }
note() { printf 'herdr-task: %s\n' "$*" >&2; }
# say: a note, plus a notification when run as a plugin action, where nobody sees stderr.
say() {
    note "$*"
    [[ -n "${HERDR_PLUGIN_ACTION_ID:-}" ]] || return 0
    "$herdr_bin" notification show "herdr-task" --body "$*" >/dev/null 2>&1 || true
}
fail() { say "$*"; exit 1; }

for dependency in jq git; do
    command -v "$dependency" >/dev/null 2>&1 || die "$dependency is required"
done
herdr_bin="${HERDR_BIN_PATH:-$(command -v herdr || true)}"
# The Herdr app's task mods call projects, parse and prepare, which need no herdr TUI.
case "${1:-}" in projects | parse | prepare | review-plan | ship-prompt | ship-direct | prunable | prune-remove) ;; *) [[ -n "$herdr_bin" ]] || die "herdr is required" ;; esac

server_running() {
    "$herdr_bin" status server --json | jq -e '.running == true' >/dev/null
}

slugify() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-60
}

current_repo() {
    git rev-parse --show-toplevel 2>/dev/null || die "not inside a repository; pass --project"
}

# pick_project [preferred...]: fzf over the repositories under the project roots, with the
# preferred repositories listed first (the top entry is fzf's default).
pick_project() {
    local roots selected preferred
    preferred=$(printf '%s\n' "$@" | grep -v '^$' | awk '!seen[$0]++')
    if [[ -z "$project_roots" ]]; then
        # No picker without roots: take the best guess, else the current repository.
        if [[ -n "$preferred" ]]; then head -n1 <<<"$preferred"; else current_repo; fi
        return
    fi
    command -v fzf >/dev/null 2>&1 || die "fzf is required for the project picker"
    IFS=: read -r -a roots <<<"$project_roots"
    selected=$( { printf '%s\n' "$preferred"; find "${roots[@]}" -mindepth 2 -maxdepth 2 -name .git 2>/dev/null | sed 's#/\.git$##' | sort; } \
        | grep -v '^$' | awk '!seen[$0]++' | fzf --prompt='Project > ') || return 1
    printf '%s\n' "$selected"
}

# Which repository a ticket's team (the ABC in ABC-123) was last started in.
team_repo_file="${XDG_CACHE_HOME:-$HOME/.cache}/herdr-task/team-repos"
team_repo() {
    [[ -f "$team_repo_file" ]] || return 0
    awk -F'\t' -v team="$1" '$1 == team { print $2 }' "$team_repo_file" | tail -n1
}
# Best effort: a lost race between two starts must never abort a task.
remember_team_repo() {
    local tmp
    mkdir -p "$(dirname "$team_repo_file")" || return 0
    tmp=$(mktemp "$team_repo_file.XXXXXX") || return 0
    if { [[ -f "$team_repo_file" ]] && awk -F'\t' -v team="$1" '$1 != team' "$team_repo_file"; printf '%s\t%s\n' "$1" "$2"; } > "$tmp" 2>/dev/null; then
        mv -f "$tmp" "$team_repo_file" 2>/dev/null || rm -f "$tmp"
    else
        rm -f "$tmp"
    fi
    return 0
}

# The Linear workspace (acme in linear.app/acme/issue/...) seen last, so a ticket id found in
# a branch name still gets a link.
linear_org_file="${XDG_CACHE_HOME:-$HOME/.cache}/herdr-task/linear-org"
remember_linear_org() {
    [[ "${1:-}" =~ ^https?://[^/]*linear\.app/([^/]+)/issue/ ]] || return 0
    mkdir -p "$(dirname "$linear_org_file")" 2>/dev/null || return 0
    printf '%s\n' "${BASH_REMATCH[1]}" > "$linear_org_file" 2>/dev/null || true
}

# Herdr keeps no metadata tokens across a server restart, so the ticket also lives on its
# branch (git config branch.<b>.linear-*), where retag finds it again. It outlives Herdr and
# goes away with the branch. save_ticket <dir> <branch> <id> <url> <title>
save_ticket() {
    local dir=$1 b=$2 id=$3 url=$4 title=$5
    [[ -n "$b" && -n "$id" ]] || return 0
    git -C "$dir" config "branch.$b.linear-id" "$id" 2>/dev/null || return 0
    if [[ -n "$url" ]]; then git -C "$dir" config "branch.$b.linear-url" "$url" 2>/dev/null || true; fi
    if [[ -n "$title" ]]; then git -C "$dir" config "branch.$b.linear-title" "$title" 2>/dev/null || true; fi
    return 0
}

# branch_ticket <dir> <branch>: sets ticket_id, ticket_url and ticket_title for a task branch:
# what start or tag saved on it, else the id in its name (abc-12-fix, me/abc-12-fix) when a
# task of that team was started before (so utf-8 is nobody's ticket), linked through the
# Linear workspace seen last. All empty for any other branch.
branch_ticket() {
    local dir=$1 b=$2 team number org
    ticket_id=$(git -C "$dir" config --get "branch.$b.linear-id" 2>/dev/null || true)
    ticket_url=$(git -C "$dir" config --get "branch.$b.linear-url" 2>/dev/null || true)
    ticket_title=$(git -C "$dir" config --get "branch.$b.linear-title" 2>/dev/null || true)
    [[ -z "$ticket_id" ]] || return 0
    ticket_url="" ticket_title=""
    [[ "${b##*/}" =~ ^([A-Za-z][A-Za-z0-9]*)-([0-9]+)(-|$) ]] || return 0
    number=${BASH_REMATCH[2]}
    team=$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]')
    [[ -n "$(team_repo "$team")" ]] || return 0
    ticket_id="$team-$number"
    org=$(cat "$linear_org_file" 2>/dev/null || true)
    if [[ -n "$org" ]]; then ticket_url="https://linear.app/$org/issue/$ticket_id"; fi
    return 0
}

# ticket_token_args <id> <url> <title>: the sidebar tokens for a ticket, into token_args.
ticket_token_args() {
    token_args=(--token "linear=${linear_glyph}  $1" --token "linear_id=$1"
                --token "linear_url=$2" --token "linear_title=$3")
}

# Sets ticket_id, ticket_url, ticket_slug, branch from a link, an id, or a branch name.
parse_ticket() {
    local ref=$1
    ticket_id="" ticket_url="" ticket_slug=""
    if [[ "$ref" =~ ^https?://[^/]*linear\.app/[^/]+/issue/([A-Za-z][A-Za-z0-9]*-[0-9]+)(/([^/?#]*))? ]]; then
        ticket_id=$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]')
        ticket_slug=${BASH_REMATCH[3]:-}
        ticket_url=${ref%%[?#]*}
    elif [[ "$ref" =~ ^([A-Za-z][A-Za-z0-9]*-[0-9]+)$ ]]; then
        ticket_id=$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]')
    fi
    if [[ -n "$ticket_id" ]]; then
        branch=$(slugify "$ticket_id")
        [[ -n "$ticket_slug" ]] && branch="$branch-$(slugify "$ticket_slug")"
        branch=${branch:0:60}
    elif git check-ref-format --branch "$ref" >/dev/null 2>&1; then
        branch=$ref
    else
        branch=$(slugify "$ref")
    fi
    [[ -n "$branch" ]] || die "could not derive a branch name from '$ref'"
}

# Gitignored env files the worktree needs that git does not carry over.
copy_env_files() {
    local source_root=$1 target_root=$2 file
    git -C "$source_root" ls-files --others --ignored --exclude-standard -- '.env' '.env.*' 'app/.env' 'app/.env.*' 2>/dev/null \
        | while read -r file; do
            [[ -f "$source_root/$file" && ! -e "$target_root/$file" ]] || continue
            mkdir -p "$target_root/$(dirname "$file")"
            cp "$source_root/$file" "$target_root/$file"
            note "copied $file"
        done
}

# start_agent <name> <kind> <pane> <prompt> [label]: label is appended to the sidebar agent
# name ("review" for reviewers).
start_agent() {
    local agent_name=$1 agent=$2 root_pane=$3 prompt=$4 label=${5:-} started=false
    # The new pane's shell takes a moment to become an available agent target.
    local err=""
    for _ in $(seq 1 20); do
        if err=$("$herdr_bin" agent start "$agent_name" --kind "$agent" --pane "$root_pane" 2>&1 >/dev/null); then
            started=true
            break
        fi
        sleep 0.5
    done
    [[ "$started" == true ]] || note "agent start failed for pane $root_pane: ${err:-no output}"
    if [[ "$started" == true ]]; then
        "$herdr_bin" pane report-metadata "$root_pane" --source "$metadata_source" \
            --display-agent "$(agent_label "$agent")${label:+ $label}" >/dev/null 2>&1 || true
        if "$herdr_bin" agent prompt "$agent_name" "$prompt" >/dev/null; then
            note "started $agent as '$agent_name' with its first prompt"
        else
            note "started $agent as '$agent_name'; paste the prompt yourself"
        fi
    else
        note "could not start $agent in pane $root_pane; the workspace is ready anyway"
    fi
}

cmd_start() {
    local ref="" project="" title="" url_opt="" agent="$default_agent" prompt="" agent_async=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--project) project=$2; shift 2 ;;
            -t|--title) title=$2; shift 2 ;;
            -u|--url) url_opt=$2; shift 2 ;;
            -a|--agent) agent=$2; shift 2 ;;
            --prompt) prompt=$2; shift 2 ;;
            --no-agent) agent=none; shift ;;
            --async-agent) agent_async=true; shift ;;
            -*) die "unknown option: $1" ;;
            *) [[ -z "$ref" ]] || die "unexpected argument: $1"; ref=$1; shift ;;
        esac
    done
    [[ -n "$ref" ]] || die "usage: herdr-task start <ticket link | id | branch> [options]"
    project=${project:-$(current_repo)}
    project=$(cd "$project" && pwd -P)
    git -C "$project" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$project is not a git repository"
    server_running || die "herdr server is not running; start herdr first"

    local ticket_id ticket_url ticket_slug branch label
    parse_ticket "$ref"
    [[ -n "$url_opt" ]] && ticket_url=$url_opt
    # The sidebar's $linear token carries the ticket id, so the label is the title alone.
    if [[ -n "$ticket_id" ]]; then
        label="${title:-${ticket_slug//-/ }}"
        [[ -n "$label" ]] || label=$ticket_id   # bare id, no title: better the id than nothing
    else
        label="${title:-$branch}"
    fi
    label=${label:0:36}

    local worktrees existing_path response workspace_id checkout_path root_pane start
    worktrees=$("$herdr_bin" worktree list --cwd "$project")
    existing_path=$(jq -r --arg b "$branch" '.result.worktrees[] | select(.branch == $b) | .path' <<<"$worktrees" | head -n1)
    if [[ -z "$existing_path" && -n "$ticket_id" && -z "$ticket_slug" ]]; then
        # A bare id reopens the ticket's existing worktree even if that branch carries the slug.
        existing_path=$(jq -r --arg p "$branch-" '.result.worktrees[] | select(.branch != null) | select(.branch | startswith($p)) | .path' <<<"$worktrees" | head -n1)
    fi
    start=$SECONDS
    if [[ -n "$existing_path" ]]; then
        note "branch $branch already has a worktree at $existing_path, opening it"
        response=$("$herdr_bin" worktree open --cwd "$project" --path "$existing_path" --label "$label" --focus)
    else
        response=$("$herdr_bin" worktree create --cwd "$project" --branch "$branch" --label "$label" --focus)
    fi
    workspace_id=$(jq -r '.result.workspace.workspace_id' <<<"$response")
    checkout_path=$(jq -r '.result.worktree.path' <<<"$response")
    root_pane=$(jq -r '.result.root_pane.pane_id' <<<"$response")
    note "workspace $workspace_id at $checkout_path ($((SECONDS - start))s)"
    [[ -n "$ticket_id" ]] && remember_team_repo "${ticket_id%%-*}" "$project"

    "$herdr_bin" workspace report-metadata "$workspace_id" --source "$metadata_source" \
        --token "repo=$(basename "$project")" >/dev/null
    if [[ -n "$ticket_id" ]]; then
        local -a token_args
        ticket_token_args "$ticket_id" "$ticket_url" "$title"
        "$herdr_bin" workspace report-metadata "$workspace_id" --source "$metadata_source" "${token_args[@]}" >/dev/null
        # A reopened worktree may sit on a longer branch than $branch (bare id): save on its own.
        save_ticket "$project" "$(git -C "$checkout_path" symbolic-ref --short -q HEAD || printf '%s' "$branch")" \
            "$ticket_id" "$ticket_url" "$title"
        remember_linear_org "$ticket_url"
    fi
    [[ -z "$existing_path" ]] && copy_env_files "$project" "$checkout_path"

    if [[ "$agent" != none ]]; then
        local agent_name
        # Unique per workspace: a ticket retried after a closed workspace must not collide
        # with an agent name Herdr still holds.
        agent_name="$(slugify "${ticket_id:-$branch}")"
        # Workspace ids carry uppercase letters (w1V); agent names must be lowercase.
        agent_name="$(slugify "${agent_name:0:26}-${workspace_id#w}")"
        if [[ -z "$prompt" ]]; then
            if [[ -n "$ticket_id" ]]; then
                prompt="Work on ${ticket_url:-$ticket_id}. Groom it first (groom skill)."
                [[ -z "$title" ]] && prompt="$prompt After reading it, name this Herdr workspace after its title, without the ticket id (the sidebar shows that already): herdr workspace rename \"\$HERDR_WORKSPACE_ID\" \"<ticket title>\"."
            else
                prompt="Task: ${title:-$branch}. Groom it first (groom skill)."
            fi
        fi
        if [[ "$agent_async" == true ]]; then
            # Let the popup close now; the agent keeps starting in the pane.
            detach "$0" agent-start "$agent_name" "$agent" "$root_pane" "$prompt"
            note "starting $agent as '$agent_name' in the background"
        else
            start_agent "$agent_name" "$agent" "$root_pane" "$prompt"
        fi
    fi

    # From a plain shell, attach after creating the workspace.
    if [[ -z "${HERDR_SOCKET_PATH:-}" ]]; then
        exec "$herdr_bin"
    fi
}

# Repository behind the focused Herdr workspace: its checkout, else its first pane's cwd.
focused_repo() {
    local ws cwd
    ws=$("$herdr_bin" workspace list 2>/dev/null | jq -r '.result.workspaces[] | select(.focused) | .worktree.repo_root // .workspace_id' | head -n1)
    [[ -n "$ws" ]] || return 0
    if [[ "$ws" == /* ]]; then
        printf '%s\n' "$ws"
        return
    fi
    cwd=$("$herdr_bin" pane list --workspace "$ws" 2>/dev/null | jq -r '.result.panes[0].cwd // empty')
    [[ -n "$cwd" ]] && git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true
}

# The ticket to suggest: a Linear link or id sitting in the clipboard, so copy-link then
# prefix+t then Enter works.
clipboard_ticket() {
    command -v pbpaste >/dev/null 2>&1 || return 0
    local clip
    clip=$(pbpaste 2>/dev/null | head -n1 | tr -d '[:space:]')
    if [[ "$clip" =~ ^https?://[^/]*linear\.app/[^/]+/issue/ || "$clip" =~ ^[A-Za-z][A-Za-z0-9]*-[0-9]+$ ]]; then
        printf '%s' "$clip"
    fi
}

# Tag the current workspace with a ticket created after the work started (groom skill):
# sidebar tokens on the workspace and this pane, the label, and the branch renamed to carry
# the ticket id while nothing has been pushed yet.
cmd_tag() {
    local ref=${1:?ticket link or id} title="" ws=${HERDR_WORKSPACE_ID:-} ticket_id ticket_url ticket_slug branch
    shift
    while [[ $# -gt 0 ]]; do
        case $1 in
            -t|--title) title=$2; shift 2 ;;
            *) die "unknown option: $1" ;;
        esac
    done
    [[ -n "$ws" ]] || die "not inside a Herdr workspace (HERDR_WORKSPACE_ID unset)"
    parse_ticket "$ref"
    [[ -n "$ticket_id" ]] || die "'$ref' is not a Linear ticket link or id"
    if [[ -z "$ticket_url" && -s "$linear_org_file" ]]; then
        ticket_url="https://linear.app/$(cat "$linear_org_file")/issue/$ticket_id"
    fi
    local -a token_args
    ticket_token_args "$ticket_id" "$ticket_url" "$title"
    "$herdr_bin" workspace report-metadata "$ws" --source "$metadata_source" "${token_args[@]}" >/dev/null
    [[ -n "${HERDR_PANE_ID:-}" ]] && "$herdr_bin" pane report-metadata "$HERDR_PANE_ID" --source "$metadata_source" "${token_args[@]}" >/dev/null
    local label="${title:-${ticket_slug//-/ }}"
    [[ -n "$label" ]] || label=$ticket_id
    "$herdr_bin" workspace rename "$ws" "${label:0:36}" >/dev/null
    local current
    current=$(git branch --show-current 2>/dev/null || true)
    if [[ -n "$current" && "$current" != "$branch" ]] && ! git rev-parse --verify -q "$current@{upstream}" >/dev/null 2>&1; then
        git branch -m "$current" "$branch" && note "branch renamed $current -> $branch" && current=$branch
    fi
    # Saved on the branch (after any rename) so retag restores it after a Herdr restart.
    save_ticket . "$current" "$ticket_id" "$ticket_url" "$title"
    remember_linear_org "$ticket_url"
    local common
    if common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
        remember_team_repo "${ticket_id%%-*}" "$(dirname "$common")"
    fi
    note "workspace tagged with $ticket_id"
}

cmd_interactive() {
    local project ref suggestion ticket_id ticket_url ticket_slug branch
    suggestion=$(clipboard_ticket)
    # readline (-e) does its own line editing, so backspace works in the popup pty whatever
    # its erase setting; vi keys like everywhere else (Esc for normal mode). No -i: macOS
    # bash 3.2 lacks it, so the suggestion is the default.
    set -o vi
    if [[ -n "$suggestion" ]]; then
        read -e -r -p "Ticket link, id, branch, or task [$suggestion]: " ref || exit 0
    else
        read -e -r -p 'Ticket link, id, branch, or task: ' ref || exit 0
    fi
    ref=${ref:-$suggestion}
    [[ -n "$ref" ]] || exit 0
    parse_ticket "$ref"
    # Best guess first: the repo this ticket's team was last started in, then the focused one.
    project=$(pick_project "$(team_repo "${ticket_id%%-*}")" "$(focused_repo)") || exit 0
    # Free text ("fix flaky login test") is a task, not a ref: keep it as the title and first
    # prompt, with the slug as the branch. A ticket or a valid branch name passes through.
    if [[ -z "$ticket_id" ]] && ! git check-ref-format --branch "$ref" >/dev/null 2>&1; then
        cmd_start "$ref" --project "$project" --title "$ref" --async-agent
    else
        cmd_start "$ref" --project "$project" --async-agent
    fi
}

# tsv_field <tsv> <key> <n>: field n of the first line whose first field equals key, literally.
tsv_field() {
    awk -F'\t' -v key="$2" -v n="$3" '$1 == key { print $n; exit }' <<<"$1"
}

# prune_verdict <worktree> <branch> <prunable>: set the caller's verdict to "remove: why" or
# "keep: why". Reads repo_root, default_branch, merged_heads and open_heads from the caller.
prune_verdict() {
    local wt_path=$1 branch=$2 prunable=$3 pr_state head_sha merged_sha
    verdict=""
    if [[ "$prunable" == true ]]; then
        verdict="remove: directory gone"
    elif [[ -z "$branch" ]]; then
        verdict="keep: detached HEAD"
    elif [[ -n "$(git -C "$wt_path" status --porcelain 2>/dev/null)" ]]; then
        verdict="keep: uncommitted changes"
    elif [[ -n "$(tsv_field "$open_heads" "$branch" 2)" ]]; then
        verdict="keep: open PR $(tsv_field "$open_heads" "$branch" 2)"
    elif git -C "$repo_root" merge-base --is-ancestor "$branch" "origin/$default_branch" 2>/dev/null; then
        verdict="remove: merged into $default_branch"
    else
        # A merged PR only proves the commit it merged; the branch may have moved on.
        head_sha=$(git -C "$repo_root" rev-parse "$branch" 2>/dev/null || true)
        merged_sha=$(tsv_field "$merged_heads" "$branch" 2)
        if [[ -z "$merged_sha" ]]; then
            # Older than the bulk lists reach: ask about this branch alone.
            pr_state=$(cd "$repo_root" && gh pr list --head "$branch" --state all --limit 1 --json state,number,headRefOid --jq '.[0] | "\(.state) #\(.number) \(.headRefOid)"' 2>/dev/null || true)
            case "$pr_state" in
                MERGED*) merged_sha=${pr_state##* } ;;
                OPEN*) verdict="keep: open PR $(cut -d' ' -f2 <<<"$pr_state")" ;;
                CLOSED*) verdict="keep: PR $(cut -d' ' -f2 <<<"$pr_state") closed unmerged" ;;
                *) verdict="keep: unmerged, no PR" ;;
            esac
        fi
        if [[ -n "$merged_sha" ]]; then
            if [[ "$merged_sha" == "$head_sha" ]]; then
                verdict="remove: PR merged"
            else
                verdict="keep: commits after the merged PR"
            fi
        fi
    fi
}

cmd_prune() {
    local project worktrees repo_root default_branch merged_heads open_heads
    local -a remove_paths remove_workspaces remove_branches
    project=${1:-$(pick_project)} || exit 0
    project=$(cd "$project" && pwd -P)
    server_running || die "herdr server is not running; start herdr first"

    worktrees=$("$herdr_bin" worktree list --cwd "$project")
    repo_root=$(jq -r '.result.source.repo_root' <<<"$worktrees")
    git -C "$repo_root" fetch --prune --quiet origin || note "fetch failed, using local refs"
    default_branch=$(git -C "$repo_root" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)
    default_branch=${default_branch:-main}
    merged_heads="" open_heads=""
    if command -v gh >/dev/null 2>&1; then
        merged_heads=$(cd "$repo_root" && gh pr list --state merged --limit 300 --json headRefName,headRefOid --jq '.[] | "\(.headRefName)\t\(.headRefOid)"' 2>/dev/null || true)
        open_heads=$(cd "$repo_root" && gh pr list --state open --limit 300 --json headRefName,number --jq '.[] | "\(.headRefName)\t#\(.number)"' 2>/dev/null || true)
    fi

    printf '%-56s %s\n' "WORKTREE" "VERDICT"
    # "-" stands in for empty fields: read collapses consecutive tabs otherwise.
    while IFS=$'\t' read -r wt_path branch workspace_id prunable; do
        local short verdict
        [[ "$branch" == "-" ]] && branch=""
        [[ "$workspace_id" == "-" ]] && workspace_id=""
        short=${wt_path/#$HOME/\~}
        prune_verdict "$wt_path" "$branch" "$prunable"
        printf '%-56s %s\n' "$short" "$verdict"
        if [[ "$verdict" == remove:* ]]; then
            remove_paths+=("$wt_path")
            remove_workspaces+=("$workspace_id")
            remove_branches+=("$branch")
        fi
    done < <(jq -r '.result.worktrees[] | select(.is_linked_worktree) | [.path, (.branch // "-"), (.open_workspace_id // "-"), (.is_prunable | tostring)] | @tsv' <<<"$worktrees")

    if [[ ${#remove_paths[@]} -eq 0 ]]; then
        note "nothing to remove"
        return
    fi
    printf '\nRemove %d worktree(s)? Branches are kept. [y/N] ' "${#remove_paths[@]}"
    read -r answer
    [[ "$answer" == [yY] ]] || { note "aborted"; return; }

    local i open_count
    for i in "${!remove_paths[@]}"; do
        # The bulk lists are capped and gh may have failed: re-check each branch before deleting.
        if [[ -n "${remove_branches[$i]}" ]] && command -v gh >/dev/null 2>&1; then
            open_count=$(cd "$repo_root" && gh pr list --head "${remove_branches[$i]}" --state open --limit 1 --json number --jq 'length' 2>/dev/null) || open_count=""
            if [[ "$open_count" != 0 ]]; then
                note "kept ${remove_paths[$i]}: open PR or GitHub lookup failed"
                continue
            fi
        fi
        if [[ -n "${remove_workspaces[$i]}" ]]; then
            if "$herdr_bin" worktree remove --workspace "${remove_workspaces[$i]}" >/dev/null; then
                note "removed ${remove_paths[$i]} (workspace ${remove_workspaces[$i]})"
            else
                note "herdr could not remove ${remove_paths[$i]}; close its workspace and retry"
            fi
        elif [[ -d "${remove_paths[$i]}" ]]; then
            git -C "$repo_root" worktree remove "${remove_paths[$i]}" && note "removed ${remove_paths[$i]}"
        fi
    done
    git -C "$repo_root" worktree prune
    note "done"
}

# prune-worktree <path>: the worktree-cleanup plugin's entry point when a workspace closes.
# Applies prune's rules to that one worktree and removes it without asking; anything not
# clearly merged is kept. Also stops the Codex plugin brokers left running for it.
cmd_prune_worktree() {
    local wt_path=$1 repo_root default_branch merged_heads="" open_heads="" branch verdict
    # A `herdr worktree remove` that closed the workspace may still be deleting the checkout.
    sleep 2
    [[ -d "$wt_path" ]] || { note "already gone: $wt_path"; return; }
    wt_path=$(cd "$wt_path" && pwd -P)
    repo_root=$(git -C "$wt_path" worktree list --porcelain | sed -n '1s/^worktree //p')
    [[ -n "$repo_root" && "$repo_root" != "$wt_path" ]] || { note "not a linked worktree: $wt_path"; return; }
    stop_codex_brokers "$wt_path"

    branch=$(git -C "$wt_path" symbolic-ref --short -q HEAD || true)
    git -C "$repo_root" fetch --prune --quiet origin || note "fetch failed, using local refs"
    default_branch=$(git -C "$repo_root" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)
    default_branch=${default_branch:-main}
    # Nobody confirms this removal, so an open PR we failed to look up keeps the worktree.
    if [[ -n "$branch" ]]; then
        open_heads=$(cd "$repo_root" && gh pr list --head "$branch" --state open --json headRefName,number --jq '.[] | "\(.headRefName)\t#\(.number)"' 2>/dev/null) ||
            { note "$wt_path: keep: GitHub lookup failed"; return 0; }
    fi
    prune_verdict "$wt_path" "$branch" false
    note "$wt_path: $verdict"
    [[ "$verdict" == remove:* ]] || return 0
    git -C "$repo_root" worktree remove "$wt_path" && note "removed $wt_path (branch kept)"
    git -C "$repo_root" worktree prune
}

# stop_codex_brokers <path>: shut down the Codex Claude Code plugin's app-server brokers for a
# workspace path, in its own data dir and in codex-review's. They outlive crashed or subagent
# sessions, so a closed workspace is the last chance to stop them.
stop_codex_brokers() {
    local hook data_dir
    hook=$(ls -d "$HOME"/.claude/plugins/cache/openai-codex/codex/*/scripts/session-lifecycle-hook.mjs 2>/dev/null | sort -V | tail -n 1) || true
    [[ -n "$hook" ]] && command -v node >/dev/null 2>&1 || return 0
    for data_dir in "$HOME/.claude/plugins/data/codex-openai-codex" "$HOME/.codex-review/companion"; do
        [[ -d "$data_dir" ]] || continue
        jq -cn --arg cwd "$1" '{cwd: $cwd, hook_event_name: "SessionEnd"}' |
            (cd "$1" && env -u CODEX_COMPANION_APP_SERVER_ENDPOINT CLAUDE_PLUGIN_DATA="$data_dir" \
                node "$hook" SessionEnd) >/dev/null 2>&1 || true
    done
}

# In a popup the window closes with the script, so hold the message until a key is pressed.
fail_open() {
    note "$*"
    if [[ -t 0 ]]; then
        printf 'press any key' >&2
        read -r -n1 -s
    fi
    exit 1
}

# Octicons (Nerd Font) for the link picker, as raw UTF-8 bytes like the glyphs above.
i_pr=$(printf '\357\220\207')        # nf-oct-git_pull_request
i_diff=$(printf '\357\223\222')      # nf-oct-file_diff
i_checks=$(printf '\357\221\236')    # nf-oct-checklist
i_fail=$(printf '\357\224\257')      # nf-oct-x_circle
i_compare=$(printf '\357\221\277')   # nf-oct-git_compare
i_branch=$(printf '\357\220\230')    # nf-oct-git_branch

# open [PANE] (prefix+o): every link for the focused task in one picker. The Linear ticket; the
# branch's PR with its changed files, its checks and each failing check's own page; PRs the
# Claude status line reported; the branch on GitHub (and a compare view before there is a PR).
# Sidebar rows and the tab bar are not clickable, so this is the keyboard route. Enter opens,
# ctrl-y copies; a single link opens straight away.
cmd_open() {
    local ws pane=${1:-} tokens links cwd="" branch="" slug="" base pr_json="" out key choice url
    if [[ -z "$pane" ]]; then
        ws=$("$herdr_bin" workspace list | jq -r '.result.workspaces[] | select(.focused) | .workspace_id' | head -n1)
        [[ -n "$ws" ]] || fail_open "no focused workspace"
        pane=$("$herdr_bin" pane list --workspace "$ws" | jq -r '[.result.panes[] | select(.focused)][0].pane_id // empty')
        [[ -n "$pane" ]] || fail_open "no focused pane"
    fi
    # Pane tokens first (ticket via herdr-task or the Claude hook, PRs via the status line);
    # the ticket falls back to the workspace, which every agent kind has.
    ws=${ws:-${pane%%:*}}
    tokens=$(jq -cs '.[1] + .[0]' \
        <("$herdr_bin" pane get "$pane" | jq -c '.result.pane.tokens // {}') \
        <("$herdr_bin" workspace get "$ws" | jq -c '.result.workspace.tokens // {}'))

    cwd=$("$herdr_bin" pane get "$pane" 2>/dev/null | jq -r '.result.pane.foreground_cwd // .result.pane.cwd // empty')
    if [[ -n "$cwd" ]] && git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
        branch=$(git -C "$cwd" symbolic-ref --short -q HEAD || true)
        slug=$(git -C "$cwd" remote get-url origin 2>/dev/null | sed -E 's#\.git$##' | sed -nE 's#^.*github\.com[:/]([^/]+/[^/]+)$#\1#p')
        base=$(git -C "$cwd" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)
        [[ "$branch" == "${base:-main}" ]] && branch=""
    fi
    if [[ -n "$branch" ]] && command -v gh >/dev/null 2>&1; then
        pr_json=$(cd "$cwd" && gh pr view --json number,url,title,statusCheckRollup 2>/dev/null) || pr_json=""
    fi

    # "label<TAB>url" lines, first occurrence of a url wins.
    links=$( {
        jq -r --arg ticket "$linear_glyph" '
            if (.linear_url // "") != "" then
                "\($ticket)  \(.linear_id // "ticket")  \(.linear_title // "")\t\(.linear_url)"
            else empty end' <<<"$tokens"
        if [[ -n "$pr_json" ]]; then
            jq -r --arg pr "$i_pr" --arg diff "$i_diff" --arg checks "$i_checks" --arg fail "$i_fail" '
                .url as $u
                | "\($pr)  #\(.number)  \(.title)\t\($u)",
                  "\($diff)  changed files\t\($u)/files",
                  "\($checks)  checks\t\($u)/checks",
                  (.statusCheckRollup[]?
                    | select((if (.conclusion // "") != "" then .conclusion else (.state // "") end | ascii_upcase) as $c
                        | ["FAILURE", "ERROR", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE"] | index($c))
                    | "\($fail)  failing: \(.name // .context)\t\(.detailsUrl // .targetUrl // "")")' <<<"$pr_json"
        elif [[ -n "$slug" && -n "$branch" ]]; then
            printf '%s  compare %s\thttps://github.com/%s/compare/%s...%s\n' "$i_compare" "$branch" "$slug" "${base:-main}" "$branch"
        fi
        # pr_url_<n> tokens: the status line reports one per PR because Herdr
        # truncates long token values. pr_url (unindexed) is the old scheme,
        # space-joined and possibly truncated, so split it and drop fragments.
        jq -r --arg pr "$i_pr" '
            [ to_entries[]
              | select(.key == "pr_url" or (.key | startswith("pr_url_")))
              | if .key == "pr_url" then (.value | split(" ")[]) else .value end
              | select(test("/pull/[0-9]+$")) ]
            | unique[]
            | "\($pr)  #\(split("/") | last)\t\(.)"' <<<"$tokens"
        if [[ -n "$slug" && -n "$branch" ]]; then
            printf '%s  branch %s\thttps://github.com/%s/tree/%s\n' "$i_branch" "$branch" "$slug" "$branch"
        fi
    } | awk -F'\t' 'NF == 2 && $2 != "" && !seen[$2]++')

    [[ -n "$links" ]] || fail_open "no ticket, PR or GitHub branch for pane $pane (start the task with prefix+t)"
    if [[ $(wc -l <<<"$links") -eq 1 ]]; then
        key="" choice=$links
    else
        command -v fzf >/dev/null 2>&1 || fail_open "fzf is required to pick between several links"
        # shellcheck disable=SC2016
        out=$(fzf --delimiter=$'\t' --with-nth=1 --prompt='Open > ' --expect=ctrl-y \
            --header='enter: open   ctrl-y: copy link' \
            --preview='u={2}; case "$u" in
                */checks) gh pr checks "${u%/checks}" 2>/dev/null ;;
                */pull/*) gh pr view "${u%/files}" 2>/dev/null | head -n 40 ;;
                *) printf "%s\n" "$u" ;;
            esac' --preview-window='down,50%,wrap' <<<"$links") || exit 0
        key=$(head -n1 <<<"$out")
        choice=$(sed -n 2p <<<"$out")
        [[ -n "$choice" ]] || exit 0
    fi
    url=${choice#*$'\t'}
    if [[ "$key" == ctrl-y ]]; then
        if command -v pbcopy >/dev/null 2>&1; then
            printf '%s' "$url" | pbcopy
            "$herdr_bin" notification show "Link copied" --body "$url" >/dev/null 2>&1 || true
        else
            fail_open "no pbcopy; the link is $url"
        fi
        return
    fi
    "${HERDR_TASK_OPEN:-open}" "$url"
}

# target_pane [PANE]: the given pane, else the calling pane (an agent's own pane, or the
# focused pane a plugin action runs for), else the focused pane.
target_pane() {
    local pane=${1:-${HERDR_PANE_ID:-}} ws
    if [[ -z "$pane" ]]; then
        ws=$("$herdr_bin" workspace list | jq -r '.result.workspaces[] | select(.focused) | .workspace_id' | head -n1)
        [[ -n "$ws" ]] || return 1
        pane=$("$herdr_bin" pane list --workspace "$ws" | jq -r '[.result.panes[] | select(.focused)][0].pane_id // empty')
    fi
    [[ -n "$pane" ]] || return 1
    printf '%s\n' "$pane"
}

# load_pane <pane>: sets pane_ws and pane_cwd (the foreground process's cwd when Herdr knows it).
load_pane() {
    local info
    info=$("$herdr_bin" pane get "$1" 2>/dev/null) || fail "pane $1 not found"
    pane_ws=$(jq -r '.result.pane.workspace_id // empty' <<<"$info")
    pane_ws=${pane_ws:-${1%%:*}}
    pane_cwd=$(jq -r '.result.pane.foreground_cwd // .result.pane.cwd // empty' <<<"$info")
    [[ -n "$pane_cwd" ]] || fail "no working directory for pane $1"
}

# load_task <pane>: load_pane, then sets repo, branch and base for the pane's task branch.
load_task() {
    load_pane "$1"
    repo=$(git -C "$pane_cwd" rev-parse --show-toplevel 2>/dev/null) || fail "pane $1 is not in a git repository"
    branch=$(git -C "$repo" symbolic-ref --short -q HEAD) || fail "detached HEAD in $repo; check out the task branch"
    if [[ -z "${base:-}" ]]; then
        base=$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)
        base=${base:-main}
    fi
    [[ "$branch" != "$base" ]] || fail "$(basename "$repo") is on $base; run this from a task branch"
}

# Linear link the workspace was tagged with by start or tag.
workspace_ticket_url() {
    "$herdr_bin" workspace get "$1" 2>/dev/null \
        | jq -r '.result.workspace.tokens.linear_url // empty' 2>/dev/null || true
}

split_pane() {
    "$herdr_bin" pane split "$1" --direction "$2" --cwd "$3" --no-focus | jq -re '.result.pane.pane_id'
}

# Reviewer panes per workspace, so a second review does not stack more splits, and ship never
# mistakes a reviewer for the task's agent.
review_state_dir="${XDG_CACHE_HOME:-$HOME/.cache}/herdr-task/reviews"

# live_reviewers <workspace>: reviewer panes recorded for the workspace that still exist.
live_reviewers() {
    local state="$review_state_dir/$1" p
    [[ -f "$state" ]] || return 0
    while read -r p; do
        [[ -n "$p" ]] && "$herdr_bin" pane get "$p" >/dev/null 2>&1 && printf '%s\n' "$p"
    done < "$state"
    return 0
}

# review_prompt <branch> <base> [ticket url]: what reviewer agents are told (TUI and app).
review_prompt() {
    printf '%s' "Review branch $1 against origin/$2 as a reviewer, not its author: read git diff origin/$2...HEAD and any uncommitted changes${3:+, and check them against $3}. Do not edit, commit or push anything. Report findings ranked by severity (bugs and regressions, risky behavior changes, missing tests, then nits), each with file:line, and end with one line: ready to ship or not."
}

# The message that tells a task's agent to ship (TUI and app).
ship_prompt="Ship this task now: follow the Pull Requests rules in AGENTS.md (local Codex review unless this PR already had one for the current logic, push, open or update the PR with the ticket id, then babysit it to merge-ready). If anything is unfinished or failing, stop and tell me instead."

cmd_review() {
    local with=${HERDR_TASK_REVIEWERS:-both} base="" pane=""
    while [[ $# -gt 0 ]]; do
        case $1 in
            --with) with=$2; shift 2 ;;
            --base) base=$2; shift 2 ;;
            --pane) pane=$2; shift 2 ;;
            *) fail "unknown option: $1" ;;
        esac
    done
    case $with in codex|claude|both) ;; *) fail "--with takes codex, claude or both" ;; esac
    server_running || fail "herdr server is not running; start herdr first"
    pane=$(target_pane "$pane") || fail "no focused pane"
    local pane_ws pane_cwd repo branch
    load_task "$pane"

    if [[ -n "$(live_reviewers "$pane_ws")" ]]; then
        say "reviewers for this workspace are still open; close them (prefix+x) for a fresh review"
        return 0
    fi
    git -C "$repo" fetch --quiet origin "$base" 2>/dev/null || note "fetch failed, reviewing against the local origin/$base"
    if git -C "$repo" diff --quiet "origin/$base...HEAD" 2>/dev/null && [[ -z "$(git -C "$repo" status --porcelain)" ]]; then
        fail "$branch has no changes against origin/$base"
    fi

    local ticket prompt first claude_pane="" codex_pane="" suffix
    ticket=$(workspace_ticket_url "$pane_ws")
    prompt=$(review_prompt "$branch" "$base" "$ticket")
    first=$(split_pane "$pane" right "$repo") || fail "could not split pane $pane"
    case $with in
        claude) claude_pane=$first ;;
        codex) codex_pane=$first ;;
        both)
            claude_pane=$first
            codex_pane=$(split_pane "$first" down "$repo") || fail "could not split pane $first"
            ;;
    esac
    mkdir -p "$review_state_dir"
    printf '%s\n' $claude_pane $codex_pane > "$review_state_dir/$pane_ws"
    suffix=$(slugify "${pane_ws#w}")

    if [[ -n "$codex_pane" ]]; then
        "$herdr_bin" pane rename "$codex_pane" "codex review" >/dev/null 2>&1 || true
        if [[ -x "$HOME/.codex-review/codex-review" ]]; then
            # Runs in the pane's shell (~ expands there); the notification marks the end of a
            # non-agent process.
            # shellcheck disable=SC2088
            "$herdr_bin" pane run "$codex_pane" "~/.codex-review/codex-review --wait --base $(printf %q "origin/$base") --scope branch; herdr notification show 'Codex review done' --body $(printf %q "$branch") --sound done" >/dev/null \
                || note "could not start the Codex review in pane $codex_pane"
        else
            start_agent "rv-codex-$suffix" codex "$codex_pane" "$prompt" review
        fi
    fi
    if [[ -n "$claude_pane" ]]; then
        "$herdr_bin" pane rename "$claude_pane" "claude review" >/dev/null 2>&1 || true
        start_agent "rv-claude-$suffix" claude "$claude_pane" "$prompt" review
    fi
    say "review of $branch started ($with)"
}

# task_agent <pane> <workspace>: the agent to ship with, as a pane id: the given pane when it
# hosts an agent, else the first other agent in the workspace. Reviewers never count.
task_agent() {
    local reviewers p
    reviewers=$(live_reviewers "$2")
    for p in "$1" $("$herdr_bin" pane list --workspace "$2" 2>/dev/null | jq -r '.result.panes[].pane_id'); do
        grep -qxF "$p" <<<"$reviewers" && continue
        if "$herdr_bin" agent get "$p" >/dev/null 2>&1; then
            printf '%s\n' "$p"
            return
        fi
    done
}

# ship_direct <ticket url> <ticket id>: with no agent to ship, push $branch of $repo and open a
# draft PR against $base (or report the open one); sets pr. TUI and app.
ship_direct() {
    local ticket=$1 ticket_id=$2 title body
    [[ -z "$(git -C "$repo" status --porcelain)" ]] || fail "uncommitted changes in $branch; commit them first"
    git -C "$repo" push --quiet -u origin HEAD 2>/dev/null || fail "git push failed for $branch"
    command -v gh >/dev/null 2>&1 || fail "pushed $branch; gh is required to open the PR"
    if pr=$(cd "$repo" && gh pr view "$branch" --json url --jq .url 2>/dev/null) && [[ -n "$pr" ]]; then
        say "pushed $branch to $pr"
        return 0
    fi
    title=$(git -C "$repo" log --reverse --format=%s "origin/$base..HEAD" | head -n1)
    title=${title:-$branch}
    [[ -n "$ticket_id" && "$title" != *"$ticket_id"* ]] && title="$ticket_id: $title"
    body="${ticket:+$ticket

}## Changes

$(git -C "$repo" log --reverse --format='- %s' "origin/$base..HEAD")"
    pr=$(cd "$repo" && gh pr create --draft --base "$base" --head "$branch" --title "$title" --body "$body" 2>/dev/null | tail -n1) \
        || fail "pushed $branch; gh pr create failed"
    say "opened draft PR $pr"
}

cmd_ship() {
    local pane=""
    while [[ $# -gt 0 ]]; do
        case $1 in
            --pane) pane=$2; shift 2 ;;
            *) fail "unknown option: $1" ;;
        esac
    done
    server_running || fail "herdr server is not running; start herdr first"
    pane=$(target_pane "$pane") || fail "no focused pane"
    local pane_ws pane_cwd repo branch base="" agent err
    load_task "$pane"

    agent=$(task_agent "$pane" "$pane_ws")
    if [[ -n "$agent" ]]; then
        # The agent already knows how (AGENTS.md, Pull Requests); this only says "now".
        if err=$("$herdr_bin" agent prompt "$agent" "$ship_prompt" 2>&1 >/dev/null); then
            say "asked the task agent to ship $branch"
        elif [[ "$err" == *agent_blocked* ]]; then
            fail "the task agent is waiting for you; answer it, then ship again"
        else
            fail "could not prompt the task agent: $err"
        fi
        return 0
    fi

    # No agent here: do the mechanical part only, as a draft for a human to finish.
    local pr
    ship_direct "$(workspace_ticket_url "$pane_ws")" \
        "$("$herdr_bin" workspace get "$pane_ws" 2>/dev/null | jq -r '.result.workspace.tokens.linear_id // empty' 2>/dev/null || true)"
    # Only feeds the prefix+o picker. The sidebar's PR badge is herdr-github's ($prs), and pane
    # tokens are one map shared by every source, so `pr` (herdr-github's) is neither set nor
    # cleared here.
    "$herdr_bin" pane report-metadata "$pane" --source "$metadata_source" \
        --token "pr_url_1=$pr" --clear-token pr_url >/dev/null 2>&1 || true
}

# open-file <file-url> [--pane PANE]: the task plugin's file:// link handler (Ctrl-click on a
# path an agent printed). Herdr opens only http(s) links itself.
cmd_open_file() {
    local url=${1:-} pane="" path line=""
    [[ -n "$url" ]] || fail "usage: herdr-task open-file <file-url> [--pane PANE]"
    shift
    while [[ $# -gt 0 ]]; do
        case $1 in
            --pane) pane=$2; shift 2 ;;
            *) fail "unknown option: $1" ;;
        esac
    done
    parse_file_url "$url"
    [[ -e "$path" ]] || fail "no such file: $path"
    pane=$(target_pane "$pane") || fail "no focused pane"
    local dir new
    if [[ -d "$path" ]]; then dir=$path; else dir=$(dirname "$path"); fi
    # Focused, unlike reviewer splits: the click asked to look at this file now.
    new=$("$herdr_bin" pane split "$pane" --direction right --cwd "$dir" --focus | jq -re '.result.pane.pane_id') \
        || fail "could not split pane $pane"
    "$herdr_bin" pane run "$new" "exec \${EDITOR:-nvim}${line:+ +$line} $(printf %q "$path")" >/dev/null \
        || fail "could not open $path"
}

# parse_file_url <url>: sets path and line. file:///p and file://host/p both give /p; the line
# comes from #L12, #12, or a trailing :12 (or :12:5) when the path without it exists.
parse_file_url() {
    path=${1#file://}
    path=/${path#*/}
    line=""
    case $path in
        *'#L'*) line=${path##*#L}; path=${path%%#L*} ;;
        *'#'*) line=${path##*#}; path=${path%%#*} ;;
    esac
    path=$(printf '%b' "${path//%/\\x}")
    # ERE has no lazy match, so strip a :col first, then the :line.
    if [[ ! -e "$path" && "$path" =~ ^(.+):([0-9]+):[0-9]+$ ]]; then
        path=${BASH_REMATCH[1]}
        line=${BASH_REMATCH[2]}
    elif [[ ! -e "$path" && "$path" =~ ^(.+):([0-9]+)$ ]]; then
        path=${BASH_REMATCH[1]}
        line=${BASH_REMATCH[2]}
    fi
    if [[ "$line" =~ ^[0-9]+ ]]; then line=${BASH_REMATCH[0]}; else line=""; fi
}

# retag [--startup] [--workspace W]: after a server restart Herdr brings back workspaces, panes
# and agent sessions but no metadata tokens, so report again what start, tag and the agent
# labels had: each task workspace's repo and ticket, and on its panes the ticket and the agent
# glyph label. Task workspaces are linked worktrees; plain checkouts are left alone. --startup
# also drops the Claude status line's "already reported" PR markers so it reports its PR links
# again. Safe to run any time.
cmd_retag() {
    local only="" startup=false agents ws dir
    while [[ $# -gt 0 ]]; do
        case $1 in
            --startup) startup=true; shift ;;
            --workspace) only=$2; shift 2 ;;
            *) die "unknown option: $1" ;;
        esac
    done
    server_running 2>/dev/null || return 0
    if [[ "$startup" == true ]]; then
        rm -f "$HOME/.claude/cache/v2-pane-pr-"* 2>/dev/null || true
    fi
    # Agent names (reviewers are rv-*); agents that have not resumed yet get theirs from the
    # pane.agent_detected hook.
    agents=$("$herdr_bin" agent list 2>/dev/null | jq -c '[.result.agents[]? | {pane_id, name}]' 2>/dev/null) || agents=""
    [[ -n "$agents" ]] || agents='[]'
    while IFS=$'\t' read -r ws dir; do
        [[ -n "$ws" && ( -z "$only" || "$ws" == "$only" ) ]] || continue
        retag_workspace "$ws" "$dir" "$agents"
    done < <("$herdr_bin" workspace list 2>/dev/null \
        | jq -r '.result.workspaces[]? | [.workspace_id, (.worktree.checkout_path // "")] | @tsv' 2>/dev/null)
}

# retag_workspace <workspace> <checkout or ""> <agents json>
retag_workspace() {
    local ws=$1 dir=$2 agents=$3 panes git_dir common b pane kind name label
    local ticket_id="" ticket_url="" ticket_title=""
    local -a token_args=() pane_args=()
    # Fields split on US (\037), not tab: tab is IFS whitespace, so an empty agent field would
    # collapse and a shell pane's cwd would be read as its agent kind.
    panes=$("$herdr_bin" pane list --workspace "$ws" 2>/dev/null \
        | jq -r '.result.panes[]? | [.pane_id, (.agent // ""), (.foreground_cwd // .cwd // "")] | join("\u001f")' 2>/dev/null) || panes=""
    [[ -n "$dir" ]] || dir=$(cut -d $'\037' -f3 <<<"$panes" | grep -m1 . || true)
    [[ -n "$dir" && -d "$dir" ]] || return 0
    git_dir=$(git -C "$dir" rev-parse --path-format=absolute --git-dir 2>/dev/null) || return 0
    common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
    [[ "$git_dir" != "$common" ]] || return 0
    b=$(git -C "$dir" symbolic-ref --short -q HEAD) || return 0

    branch_ticket "$dir" "$b"
    [[ -z "$ticket_id" ]] || ticket_token_args "$ticket_id" "$ticket_url" "$ticket_title"
    "$herdr_bin" workspace report-metadata "$ws" --source "$metadata_source" \
        --token "repo=$(basename "$(dirname "$common")")" ${token_args[@]+"${token_args[@]}"} >/dev/null 2>&1 || true
    while IFS=$'\037' read -r pane kind _; do
        [[ -n "$pane" ]] || continue
        pane_args=(${token_args[@]+"${token_args[@]}"})
        if [[ -n "$kind" ]]; then
            name=$(jq -r --arg p "$pane" '[.[] | select(.pane_id == $p) | .name // empty][0] // empty' <<<"$agents")
            label=$(agent_label "$kind")
            [[ "$name" == rv-* ]] && label="$label review"
            pane_args+=(--display-agent "$label")
        fi
        [[ ${#pane_args[@]} -gt 0 ]] || continue
        "$herdr_bin" pane report-metadata "$pane" --source "$metadata_source" "${pane_args[@]}" >/dev/null 2>&1 || true
    done <<<"$panes"
}

# open-ticket <url>: the task plugin's Ctrl-click handler for Linear links. Focus the open
# workspace of that ticket's task, else open the link in the browser (Herdr opens nothing
# itself once a handler matches).
cmd_open_ticket() {
    local url=${1:?Linear link} ticket_id ticket_url ticket_slug branch ws=""
    parse_ticket "$url"
    if [[ -n "$ticket_id" ]] && server_running 2>/dev/null; then
        ws=$(ticket_workspace "$ticket_id")
    fi
    if [[ -n "$ws" ]] && "$herdr_bin" workspace focus "$ws" >/dev/null 2>&1; then
        return 0
    fi
    "${HERDR_TASK_OPEN:-open}" "$url"
}

# ticket_workspace <ID>: the open workspace tagged with the ticket, else the one whose worktree
# branch carries its id (abc-12, abc-12-fix, me/abc-12-fix).
ticket_workspace() {
    local id=$1 list ws dir b slug
    list=$("$herdr_bin" workspace list 2>/dev/null) || return 0
    ws=$(jq -r --arg id "$id" '[.result.workspaces[]? | select(.tokens.linear_id? == $id)][0].workspace_id // empty' <<<"$list" 2>/dev/null)
    if [[ -n "$ws" ]]; then
        printf '%s\n' "$ws"
        return
    fi
    slug=$(slugify "$id")
    while IFS=$'\t' read -r ws dir; do
        [[ -n "$dir" ]] || continue
        b=$(git -C "$dir" symbolic-ref --short -q HEAD 2>/dev/null) || continue
        b=${b##*/}
        if [[ "$b" == "$slug" || "$b" == "$slug"-* ]]; then
            printf '%s\n' "$ws"
            return
        fi
    done < <(jq -r '.result.workspaces[]? | [.workspace_id, (.worktree.checkout_path // "")] | @tsv' <<<"$list" 2>/dev/null)
}

# --- The Herdr app's task mods (herdr-app/mods/task-start, task-projects) -------------------
# JSON on stdout, notes on stderr; no herdr server. The mod opens the space itself.

# The main checkout behind a folder (a worktree's repository), else nothing.
repo_of() {
    local common
    common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
    if [[ "$common" == */.git ]]; then
        printf '%s\n' "${common%/.git}"
    else
        git -C "$1" rev-parse --show-toplevel 2>/dev/null || true
    fi
}

# json_projects [preferred...]: the preferred repositories, then every one under the roots.
json_projects() {
    local -a roots=()
    {
        printf '%s\n' "$@"
        if [[ -n "$project_roots" ]]; then
            IFS=: read -r -a roots <<<"$project_roots"
            find "${roots[@]}" -mindepth 2 -maxdepth 2 -name .git 2>/dev/null | sed 's#/\.git$##' | sort
        fi
    } | grep -v '^$' | awk '!seen[$0]++' | jq -R . | jq -sc .
}

# projects [--cwd DIR]: {"projects": [...]}, the focused repository first.
cmd_projects() {
    local cwd="" here=""
    [[ "${1:-}" == --cwd ]] && cwd=${2:-}
    [[ -n "$cwd" ]] && here=$(repo_of "$cwd")
    jq -nc --argjson p "$(json_projects "$here")" '{projects: $p}'
}

# parse <ref> [--cwd DIR]: what prefix+t would start, for the popup's preview: kind (ticket,
# branch or task), ticket id and link, branch, title (free text), and the projects with the
# best guess first (this ticket's team's last repository, then the focused one).
cmd_parse() {
    local ref=${1:?ticket link, id, branch or task} cwd="" kind title="" team="" here=""
    local ticket_id ticket_url ticket_slug branch
    [[ "${2:-}" == --cwd ]] && cwd=${3:-}
    parse_ticket "$ref"
    if [[ -n "$ticket_id" ]]; then
        kind=ticket
        team=$(team_repo "${ticket_id%%-*}")
    elif git check-ref-format --branch "$ref" >/dev/null 2>&1; then
        kind=branch
    else
        kind=task title=$ref
    fi
    [[ -n "$cwd" ]] && here=$(repo_of "$cwd")
    jq -nc --arg kind "$kind" --arg id "$ticket_id" --arg url "$ticket_url" --arg branch "$branch" \
        --arg title "$title" --argjson projects "$(json_projects "$team" "$here")" \
        '{kind: $kind, ticket_id: $id, ticket_url: $url, branch: $branch, title: $title, projects: $projects}'
}

# prepare <ref> --project DIR [--title T] [--agent KIND]: the worktree for a ticket, branch or
# task (the branch's own worktree if it has one), the ticket saved on its branch as start
# does, env files copied. Prints {path, branch, label, existing, agent, prompt, ticket_id,
# ticket_url}; the mod opens or focuses the space and starts the agent.
cmd_prepare() {
    local ref="" project="" title="" agent="$default_agent" ticket_id ticket_url ticket_slug branch
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--project) project=$2; shift 2 ;;
            -t|--title) title=$2; shift 2 ;;
            -a|--agent) agent=$2; shift 2 ;;
            -*) die "unknown option: $1" ;;
            *) [[ -z "$ref" ]] || die "unexpected argument: $1"; ref=$1; shift ;;
        esac
    done
    [[ -n "$ref" && -n "$project" ]] || die "usage: herdr-task prepare <ticket | branch | task> --project DIR"
    project=$(repo_of "$project")
    [[ -n "$project" ]] || die "not a git repository"
    parse_ticket "$ref"
    # Free text is the title and the first prompt; its slug is the branch.
    if [[ -z "$ticket_id" ]] && ! git check-ref-format --branch "$ref" >/dev/null 2>&1; then
        title=${title:-$ref}
    fi

    local path existing=false bare=""
    [[ -n "$ticket_id" && -z "$ticket_slug" ]] && bare=1
    # The branch's worktree, or for a bare id one on an id-slug branch.
    path=$(git -C "$project" worktree list --porcelain | awk -v b="refs/heads/$branch" -v p="refs/heads/$branch-" -v bare="$bare" '
        /^worktree / { wt = substr($0, 10) }
        /^branch / { r = substr($0, 8); if (r == b || (bare && index(r, p) == 1)) { print wt; exit } }')
    if [[ -n "$path" ]]; then
        existing=true
        note "branch $branch already has a worktree at $path, opening it"
    else
        path="$worktrees_dir/$(basename "$project")/${branch//\//-}"
        mkdir -p "$(dirname "$path")"
        git -C "$project" fetch -q origin 2>/dev/null || true
        if git -C "$project" show-ref -q --verify "refs/heads/$branch"; then
            git -C "$project" worktree add -q "$path" "$branch" >&2 || die "git worktree add failed"
        elif git -C "$project" show-ref -q --verify "refs/remotes/origin/$branch"; then
            # Published but never checked out here: start from its commits, tracking it.
            git -C "$project" worktree add -q --track -b "$branch" "$path" "origin/$branch" >&2 || die "git worktree add failed"
        else
            local base
            base=$(git -C "$project" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || echo HEAD)
            git -C "$project" worktree add -q -b "$branch" "$path" "$base" >&2 || die "git worktree add failed"
            git -C "$path" branch -q --unset-upstream 2>/dev/null || true
        fi
        copy_env_files "$project" "$path" >&2
    fi

    local b label rest
    b=$(git -C "$path" symbolic-ref --short -q HEAD || printf '%s' "$branch")
    if [[ -n "$ticket_id" ]]; then
        save_ticket "$project" "$b" "$ticket_id" "$ticket_url" "$title"
        remember_team_repo "${ticket_id%%-*}" "$project"
        remember_linear_org "$ticket_url"
        # A saved link carries the slug; keep it over one rebuilt from a bare id.
        ticket_url=$(git -C "$project" config --get "branch.$b.linear-url" 2>/dev/null || true)
        if [[ -z "$title" ]]; then
            title=$(git -C "$project" config --get "branch.$b.linear-title" 2>/dev/null || true)
        fi
        if [[ -z "$ticket_url" && -s "$linear_org_file" ]]; then
            ticket_url="https://linear.app/$(cat "$linear_org_file")/issue/$ticket_id"
            save_ticket "$project" "$b" "$ticket_id" "$ticket_url" ""
        fi
        # The app has no sidebar ticket token, so the space name carries the id.
        rest=${b#"$(slugify "$ticket_id")"}
        rest=${rest#-}
        label="$ticket_id ${title:-${rest//-/ }}"
    else
        label=${title:-$b}
    fi
    label=${label% }
    label=${label:0:48}

    local prompt=""
    if [[ "$agent" != none ]]; then
        if [[ -n "$ticket_id" ]]; then
            prompt="Work on ${ticket_url:-$ticket_id}. Groom it first (groom skill)."
            if [[ -z "$title" ]]; then
                # shellcheck disable=SC2016
                prompt+=' After reading it, name this Herdr space after it: herdr-app do space.rename --id "$(herdr-app ls | jq -r --arg t "$HC_TERMINAL_ID" '\''.spaces[] | select(any(.tabs[].terminals[]; .terminal == $t)) | .id'\'')" --name "'"$ticket_id"' <ticket title>".'
            fi
        else
            prompt="Task: ${title:-$b}. Groom it first (groom skill)."
        fi
    fi
    jq -nc --arg path "$path" --arg branch "$b" --arg label "$label" --argjson existing "$existing" \
        --arg agent "$agent" --arg prompt "$prompt" --arg id "$ticket_id" --arg url "$ticket_url" \
        '{path: $path, branch: $branch, label: $label, existing: $existing,
          agent: (if $agent == "none" then null else $agent end), prompt: $prompt, ticket_id: $id, ticket_url: $url}'
}

# task_at <dir>: the task branch checked out in dir: sets repo, branch, base (as load_task) and
# ticket_id, ticket_url, ticket_title (branch_ticket).
task_at() {
    repo=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || fail "$1 is not in a git repository"
    branch=$(git -C "$repo" symbolic-ref --short -q HEAD) || fail "detached HEAD in $repo; check out the task branch"
    base=$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)
    base=${base:-main}
    [[ "$branch" != "$base" ]] || fail "$(basename "$repo") is on $base; run this from a task branch"
    branch_ticket "$repo" "$branch"
}

# review-plan --cwd DIR: what prefix+y needs to open reviewers beside the pane: {repo, branch,
# base, prompt, codex} (codex: the local Codex review command, or null for a Codex agent).
cmd_review_plan() {
    [[ "${1:-}" == --cwd && -n "${2:-}" ]] || die "usage: herdr-task review-plan --cwd DIR"
    local repo branch base ticket_id ticket_url ticket_title codex=""
    task_at "$2"
    git -C "$repo" fetch --quiet origin "$base" 2>/dev/null || note "fetch failed, reviewing against the local origin/$base"
    if git -C "$repo" diff --quiet "origin/$base...HEAD" 2>/dev/null && [[ -z "$(git -C "$repo" status --porcelain)" ]]; then
        fail "$branch has no changes against origin/$base"
    fi
    # shellcheck disable=SC2088
    [[ -x "$HOME/.codex-review/codex-review" ]] && codex="~/.codex-review/codex-review --wait --base $(printf %q "origin/$base") --scope branch"
    jq -nc --arg repo "$repo" --arg branch "$branch" --arg base "$base" --arg codex "$codex" \
        --arg prompt "$(review_prompt "$branch" "$base" "$ticket_url")" \
        '{repo: $repo, branch: $branch, base: $base, prompt: $prompt, codex: (if $codex == "" then null else $codex end)}'
}

# ship-direct --cwd DIR: prefix+u with no agent in the space: push and open a draft PR. {pr}.
cmd_ship_direct() {
    [[ "${1:-}" == --cwd && -n "${2:-}" ]] || die "usage: herdr-task ship-direct --cwd DIR"
    local repo branch base ticket_id ticket_url ticket_title pr=""
    task_at "$2"
    ship_direct "$ticket_url" "$ticket_id"
    jq -nc --arg pr "$pr" --arg branch "$branch" '{pr: $pr, branch: $branch}'
}

# prunable --cwd DIR: every linked worktree of DIR's repository with prune's verdict:
# {repo, worktrees: [{path, branch, verdict, remove}]}.
cmd_prunable() {
    [[ "${1:-}" == --cwd && -n "${2:-}" ]] || die "usage: herdr-task prunable --cwd DIR"
    local repo_root default_branch merged_heads="" open_heads="" wt_path wt_branch prunable verdict
    repo_root=$(repo_of "$2")
    [[ -n "$repo_root" ]] || die "$2 is not in a git repository"
    git -C "$repo_root" fetch --prune --quiet origin 2>/dev/null || note "fetch failed, using local refs"
    default_branch=$(git -C "$repo_root" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)
    default_branch=${default_branch:-main}
    if command -v gh >/dev/null 2>&1; then
        merged_heads=$(cd "$repo_root" && gh pr list --state merged --limit 300 --json headRefName,headRefOid --jq '.[] | "\(.headRefName)\t\(.headRefOid)"' 2>/dev/null || true)
        open_heads=$(cd "$repo_root" && gh pr list --state open --limit 300 --json headRefName,number --jq '.[] | "\(.headRefName)\t#\(.number)"' 2>/dev/null || true)
    fi
    # "-" stands in for empty fields: read collapses consecutive tabs otherwise. The first
    # entry is the main checkout.
    while IFS=$'\t' read -r wt_path wt_branch prunable; do
        [[ "$wt_branch" == "-" ]] && wt_branch=""
        prune_verdict "$wt_path" "$wt_branch" "$prunable"
        jq -nc --arg path "$wt_path" --arg branch "$wt_branch" --arg verdict "$verdict" \
            '{path: $path, branch: $branch, verdict: ($verdict | sub("^(remove|keep): "; "")), remove: ($verdict | startswith("remove"))}'
    done < <(git -C "$repo_root" worktree list --porcelain | awk '
        function out() { if (path != "" && seen++) printf "%s\t%s\t%s\n", path, (b == "" ? "-" : b), (gone ? "true" : "false") }
        /^worktree / { out(); path = substr($0, 10); b = ""; gone = 0 }
        /^branch / { b = substr($0, 8); sub(/^refs\/heads\//, "", b) }
        /^prunable/ { gone = 1 }
        END { out() }') | jq -sc --arg repo "$repo_root" '{repo: $repo, worktrees: .}'
}

# prune-remove --cwd DIR PATH...: remove those worktrees of DIR's repository (branches kept),
# each re-checked for an open PR first. The app closes their spaces before. {removed, kept}.
cmd_prune_remove() {
    [[ "${1:-}" == --cwd && -n "${2:-}" ]] || die "usage: herdr-task prune-remove --cwd DIR PATH..."
    local repo_root wt b open_count removed=() kept=()
    repo_root=$(repo_of "$2")
    [[ -n "$repo_root" ]] || die "$2 is not in a git repository"
    shift 2
    for wt in "$@"; do
        if [[ "$(cd "$wt" 2>/dev/null && pwd -P)" == "$(cd "$repo_root" && pwd -P)" ]]; then
            kept+=("$(jq -nc --arg p "$wt" '{path: $p, why: "the main checkout"}')")
            continue
        fi
        b=$(git -C "$wt" symbolic-ref --short -q HEAD 2>/dev/null || true)
        if [[ -n "$b" ]] && command -v gh >/dev/null 2>&1; then
            open_count=$(cd "$repo_root" && gh pr list --head "$b" --state open --limit 1 --json number --jq 'length' 2>/dev/null) || open_count=""
            if [[ "$open_count" != 0 ]]; then
                kept+=("$(jq -nc --arg p "$wt" '{path: $p, why: "open PR or GitHub lookup failed"}')")
                continue
            fi
        fi
        if [[ ! -d "$wt" ]] || git -C "$repo_root" worktree remove "$wt" 2>/dev/null; then
            removed+=("$wt")
        else
            kept+=("$(jq -nc --arg p "$wt" '{path: $p, why: "git worktree remove failed (uncommitted changes?)"}')")
        fi
    done
    git -C "$repo_root" worktree prune
    # ${a[@]+...}: bash 3.2 calls an empty array unbound under set -u.
    jq -nc --args '{removed: $ARGS.positional}' ${removed[@]+"${removed[@]}"} \
        | jq -c --argjson kept "[$(IFS=,; printf '%s' "${kept[*]+${kept[*]}}")]" '. + {kept: $kept}'
}

# Sourced for tests: define the functions and stop.
if [[ -n "${HERDR_TASK_SOURCE_ONLY:-}" ]]; then
    # shellcheck disable=SC2317
    return 0 2>/dev/null || exit 0
fi

case "${1:-}" in
    "") cmd_interactive ;;
    start) shift; cmd_start "$@" ;;
    branch) parse_ticket "${2:?ticket}"; printf '%s\n' "$branch" ;;
    tag) cmd_tag "${2:?ticket}" "${@:3}" ;;
    open) cmd_open "${2:-}" ;;
    agent-start) start_agent "$2" "$3" "$4" "$5" "${6:-}" ;;
    review) shift; cmd_review "$@" ;;
    ship) shift; cmd_ship "$@" ;;
    open-file) shift; cmd_open_file "$@" ;;
    open-ticket) cmd_open_ticket "${2:?Linear link}" ;;
    retag) shift; cmd_retag "$@" ;;
    prune) cmd_prune "${2:-}" ;;
    prune-worktree) cmd_prune_worktree "${2:?worktree path}" ;;
    projects) shift; cmd_projects "$@" ;;
    parse) shift; cmd_parse "$@" ;;
    prepare) shift; cmd_prepare "$@" ;;
    review-plan) shift; cmd_review_plan "$@" ;;
    ship-prompt) printf '%s\n' "$ship_prompt" ;;
    ship-direct) shift; cmd_ship_direct "$@" ;;
    prunable) shift; cmd_prunable "$@" ;;
    prune-remove) shift; cmd_prune_remove "$@" ;;
    -h|--help) awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0" ;;
    *) die "unknown command: $1 (start, tag, open, review, ship, open-file, open-ticket, retag, prune, prune-worktree, branch)" ;;
esac
