#!/usr/bin/env bash
# Task workflow for Rex, the Rex counterpart of herdr-task. Same tickets, branches and
# worktrees (the ticket is saved on the branch as git config branch.<b>.linear-*), so a
# task started from either tool opens in the other.
#
#   rex-task                      interactive (ctrl+b>t): a Linear link or id, a branch name,
#                                 or free text; suggested from the clipboard. Creates (or
#                                 reopens) the worktree, opens a Rex session named
#                                 "ABC-123 title" there and starts the agent with the ticket.
#   rex-task start <ticket> [-p DIR] [-t TITLE] [-a claude|codex|none] [--prompt TEXT]
#   rex-task open [DIR]           (ctrl+b>o) the ticket, PR, changed files, checks and branch for
#                                 the checkout at DIR (default: the current directory); opens
#                                 one, or picks between several with fzf
#   rex-task project [DIR]        (ctrl+b>f) open or focus a session for a project under
#                                 HERDR_TASK_PROJECT_ROOTS
#   rex-task review SESSION BLOCK (ctrl+b>y) Claude reviewer right of BLOCK, Codex below it, both on
#                                 the branch diff; focus stays on BLOCK
#   rex-task ship SESSION BLOCK   (ctrl+b>u) tell the task's agent (BLOCK's if it is one, else the
#                                 session's first) to ship; with no agent, push and open a draft PR
#   rex-task prs [DIR]            (ctrl+b>m) pull requests in fzf: alt-1 mine, alt-2 review requested,
#                                 alt-3 DIR's repo. enter opens, ctrl-y copies the link, ctrl-w opens
#                                 the branch as a worktree session
#   rex-task prune [DIR]          (ctrl+b>alt+t) merged worktrees of DIR's repo: y/N, closes their
#                                 sessions, removes them (branches are kept)
#   rex-task agent next|prev|N [SESSION BLOCK]
#                                 (ctrl+b>a, shift+a, alt+1..9) go to the next, previous or Nth Claude
#                                 or Codex terminal across sessions, relative to BLOCK
#   rex-task scrollback SESSION BLOCK
#                                 (ctrl+b>e) BLOCK's screen and scrollback in $EDITOR at the end
#
# REX_TASK_WORKTREES is where worktrees go (default ~/.herdr/worktrees, Herdr's directory).
# Switching the app to the new session needs Settings > Server > Client Info > Remote Control;
# without it the session is created and ctrl+b>w lists it.

set -euo pipefail

error_mode=""   # tty or layer: see notice
die() { printf 'rex-task: %s\n' "$*" >&2; [[ -z "$error_mode" ]] || notice "$*"; exit 1; }
note() { printf 'rex-task: %s\n' "$*" >&2; }

for dependency in git jq; do
    command -v "$dependency" >/dev/null 2>&1 || die "$dependency is required"
done
rex_bin=$(command -v rex || true)
[[ -n "$rex_bin" || -z "${REX_BIN_DIR:-}" ]] || rex_bin="$REX_BIN_DIR/rex"
# Started from Rex's config (no Rex PATH), look inside the app.
if [[ -z "$rex_bin" ]]; then
    for app in "/Applications/Rex Beta.app" "/Applications/Rex.app" "$HOME/Applications/Rex.app"; do
        [[ -x "$app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex" ]] && { rex_bin="$app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex"; break; }
    done
fi
[[ -n "$rex_bin" ]] || die "rex is required"
if [[ -z "${FZF_DEFAULT_OPTS_FILE:-}" && -f "$HOME/.config/fzf/fzfrc" ]]; then
    export FZF_DEFAULT_OPTS_FILE="$HOME/.config/fzf/fzfrc"
fi
worktrees_dir="${REX_TASK_WORKTREES:-$HOME/.herdr/worktrees}"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/herdr-task"   # shared with herdr-task
default_agent="${HERDR_TASK_AGENT:-claude}"
linear_glyph=$(printf '\356\206\260')  # U+E1B0, Linear logo from herdr/fonts/HerdrTaskIcons

# OSC 8 hyperlink, clickable in Rex, Ghostty and Herdr.
hyperlink() { printf '\033]8;;%s\033\\%s\033]8;;\033\\' "$1" "$2"; }

slugify() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-60
}

# Sets ticket_id, ticket_url, ticket_slug and branch from a link, an id, or a branch name.
parse_ticket() {
    local ref=$1
    ticket_id="" ticket_url="" ticket_slug=""
    if [[ "$ref" =~ ^https?://[^/]*linear\.app/[^/]+/issue/([A-Za-z][A-Za-z0-9]*-[0-9]+)(/([^/?#]*))? ]]; then
        ticket_id=$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]')
        ticket_slug=${BASH_REMATCH[3]:-}
        ticket_url=${ref%%[?#]*}
    elif [[ "$ref" =~ ^([A-Za-z][A-Za-z0-9]*-[0-9]+)$ ]]; then
        ticket_id=$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]')
        local org
        org=$(cat "$cache_dir/linear-org" 2>/dev/null || true)
        [[ -z "$org" ]] || ticket_url="https://linear.app/$org/issue/$ticket_id"
    fi
    if [[ -n "$ticket_id" ]]; then
        branch=$(slugify "$ticket_id")
        [[ -n "$ticket_slug" ]] && branch="$branch-$(slugify "$ticket_slug")"
        branch=${branch:0:60}
    elif git check-ref-format --branch "$ref" >/dev/null 2>&1; then
        branch=$ref
    else
        branch=$(slugify "$ref")
    fi
    [[ -n "$branch" ]] || die "could not derive a branch name from '$ref'"
}

# session_dir <session>: the working directory of the session's first pane.
session_dir() {
    local block
    block=$("$rex_bin" block ls -s "$1" --json 2>/dev/null | jq -r 'first(.blocks[] | select(.creator_name == "com.superlogical.terminal") | .block_id) // empty')
    [[ -n "$block" ]] || return 0
    "$rex_bin" block call -s "$1" -b "$block" process 2>/dev/null | jq -r '.foreground.cwd // .child.cwd // empty'
}

# session_for <label> <dir> [ticket]: a session with this label, or named after the ticket,
# whose pane sits in dir (or below it), so the same branch in two repos never shares one.
session_for() {
    local label=$1 dir=$2 ticket=${3:-} id cwd
    while read -r id; do
        [[ -n "$id" ]] || continue
        cwd=$(session_dir "$id")
        cwd=$(cd "$cwd" 2>/dev/null && pwd -P || printf '%s' "$cwd")
        if [[ "$cwd" == "$dir" || "$cwd" == "$dir"/* ]]; then
            printf '%s\n' "$id"
            return
        fi
    done < <("$rex_bin" ls --json | jq -r --arg l "$label" --arg t "$ticket" '
        .sessions[] | select(.label == $l or ($t != "" and (.label == $t or (.label | startswith($t + " "))))) | .session_id')
}

# Show a session in the app. Needs Remote Control; otherwise say where to find it.
show_session() {
    local session=$1 label=$2 client
    client=$("$rex_bin" client ls --json | jq -r 'first(.clients[] | select(.info.kind == "app") | .client_id) // empty')
    if [[ -n "$client" ]] && "$rex_bin" -C "$client" "do" session.select "session_id=$session" >/dev/null 2>&1; then
        return 0
    fi
    note "session '$label' is ready: ctrl+b>w to switch (turn on Remote Control in Rex to switch automatically)"
    sleep 2
}

# open_session <label> <dir> [command] [ticket]: focus this checkout's session (by label or
# ticket), else create it in dir and type command into its shell.
open_session() {
    local label=$1 dir=$2 command=${3:-} ticket=${4:-} session created block
    dir=$(cd "$dir" && pwd -P)
    session=$(session_for "$label" "$dir" "$ticket")
    if [[ -z "$session" ]]; then
        created=$("$rex_bin" new "$label" -c "$dir" --json)
        session=$(jq -r '.session_id' <<<"$created")
        block=$(jq -r '.initial_windows[0].block_ids[0]' <<<"$created")
        if [[ -n "$command" ]]; then
            sleep 0.5   # let the shell draw its prompt before typing into it
            "$rex_bin" send -s "$session" -b "$block" "$command"$'\n' >/dev/null
        fi
        note "created session '$label' in $dir"
    fi
    show_session "$session" "$label"
}

project_roots() {
    [[ -n "${HERDR_TASK_PROJECT_ROOTS:-}" ]] || return 0
    local -a roots
    IFS=: read -r -a roots <<<"$HERDR_TASK_PROJECT_ROOTS"
    find "${roots[@]}" -mindepth 2 -maxdepth 2 -name .git 2>/dev/null | sed 's#/\.git$##' | sort
}

# pick_project [preferred]: the preferred repository first, then every one under the roots.
pick_project() {
    local list
    list=$( { [[ -z "${1:-}" ]] || printf '%s\n' "$1"; project_roots; } | awk 'NF && !seen[$0]++')
    [[ -n "$list" ]] || { git rev-parse --show-toplevel 2>/dev/null || die "set HERDR_TASK_PROJECT_ROOTS or pass --project"; return; }
    command -v fzf >/dev/null 2>&1 || { head -n1 <<<"$list"; return; }
    fzf --prompt='Project > ' <<<"$list"
}

cmd_start() {
    local ref="" project="" title="" agent="$default_agent" prompt=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--project) project=$2; shift 2 ;;
            -t|--title) title=$2; shift 2 ;;
            -a|--agent) agent=$2; shift 2 ;;
            --prompt) prompt=$2; shift 2 ;;
            -*) die "unknown option: $1" ;;
            *) [[ -z "$ref" ]] || die "unexpected argument: $1"; ref=$1; shift ;;
        esac
    done
    [[ -n "$ref" ]] || die "usage: rex-task start <ticket link | id | branch> [options]"
    project=${project:-$(git rev-parse --show-toplevel 2>/dev/null || die "not inside a repository; pass --project")}
    project=$(cd "$project" && pwd -P)

    local ticket_id ticket_url ticket_slug branch label path
    parse_ticket "$ref"
    if [[ -n "$ticket_id" ]]; then
        label="$ticket_id ${title:-${ticket_slug//-/ }}"
    else
        label="${title:-$branch}"
    fi
    label=${label% }
    label=${label:0:48}

    # Reuse the branch's worktree if it has one (a bare id also matches id-slug branches).
    path=$(git -C "$project" worktree list --porcelain | awk -v b="refs/heads/$branch" -v p="refs/heads/$branch-" -v bare="$([[ -n "$ticket_id" && -z "$ticket_slug" ]] && echo 1)" '
        /^worktree / { wt = substr($0, 10) }
        /^branch / { r = substr($0, 8); if (r == b || (bare && index(r, p) == 1)) { print wt; exit } }')
    if [[ -z "$path" ]]; then
        path="$worktrees_dir/$(basename "$project")/$branch"
        mkdir -p "$(dirname "$path")"
        git -C "$project" fetch -q origin 2>/dev/null || true
        if git -C "$project" show-ref -q --verify "refs/heads/$branch"; then
            git -C "$project" worktree add -q "$path" "$branch"
        else
            local base
            base=$(git -C "$project" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || echo HEAD)
            git -C "$project" worktree add -q -b "$branch" "$path" "$base"
            git -C "$path" branch -q --unset-upstream 2>/dev/null || true
        fi
        # Gitignored env files the worktree needs that git does not carry over.
        git -C "$project" ls-files --others --ignored --exclude-standard -- '.env' '.env.*' 'app/.env' 'app/.env.*' 2>/dev/null \
            | while read -r f; do
                [[ -f "$project/$f" && ! -e "$path/$f" ]] || continue
                mkdir -p "$path/$(dirname "$f")" && cp "$project/$f" "$path/$f" && note "copied $f"
            done
        note "worktree $path"
    else
        note "branch $branch already has a worktree at $path, opening it"
        # A bare id reopening an id-slug branch: name the session after the slug, as before.
        local b_now
        b_now=$(git -C "$path" symbolic-ref --short -q HEAD || true)
        if [[ -n "$ticket_id" && -z "$title" && -z "$ticket_slug" && "$b_now" == "$branch"-* ]]; then
            title=$(git -C "$project" config --get "branch.$b_now.linear-title" 2>/dev/null || true)
            local rest=${b_now#"$branch"-}
            label="$ticket_id ${title:-${rest//-/ }}"
            label=${label:0:48}
        fi
    fi

    if [[ -n "$ticket_id" ]]; then
        local b
        b=$(git -C "$path" symbolic-ref --short -q HEAD || printf '%s' "$branch")
        git -C "$project" config "branch.$b.linear-id" "$ticket_id"
        # Keep a saved link (it carries the slug) over one rebuilt from a bare id.
        if [[ -n "$ticket_slug" ]] || ! git -C "$project" config --get "branch.$b.linear-url" >/dev/null 2>&1; then
            [[ -z "$ticket_url" ]] || git -C "$project" config "branch.$b.linear-url" "$ticket_url"
        fi
        ticket_url=$(git -C "$project" config --get "branch.$b.linear-url" 2>/dev/null || printf '%s' "$ticket_url")
        [[ -z "$title" ]] || git -C "$project" config "branch.$b.linear-title" "$title"
        mkdir -p "$cache_dir"
        if [[ "$ticket_url" =~ ^https?://[^/]*linear\.app/([^/]+)/issue/ ]]; then
            printf '%s\n' "${BASH_REMATCH[1]}" > "$cache_dir/linear-org"
        fi
        { [[ -f "$cache_dir/team-repos" ]] && awk -F'\t' -v t="${ticket_id%%-*}" '$1 != t' "$cache_dir/team-repos"
          printf '%s\t%s\n' "${ticket_id%%-*}" "$project"; } > "$cache_dir/team-repos.tmp" && mv -f "$cache_dir/team-repos.tmp" "$cache_dir/team-repos"
        printf '%s  %s\n' "$linear_glyph" "$(hyperlink "${ticket_url:-$ticket_id}" "$ticket_id")" >&2
    fi

    local command=""
    if [[ "$agent" != none ]]; then
        if [[ -z "$prompt" ]]; then
            if [[ -n "$ticket_id" ]]; then
                prompt="Work on ${ticket_url:-$ticket_id}. Groom it first (groom skill)."
                [[ -n "$title" ]] || prompt="$prompt After reading it, name this Rex session after it: rex session rename \"\$REX_SESSION\" \"$ticket_id <ticket title>\"."
            else
                prompt="Task: ${title:-$branch}. Groom it first (groom skill)."
            fi
        fi
        command="$agent $(printf '%q' "$prompt")"
    fi
    open_session "$label" "$path" "$command" "$ticket_id"
}

cmd_interactive() {
    local ref suggestion clip ticket_id ticket_url ticket_slug branch project team_repo=""
    clip=$(pbpaste 2>/dev/null | head -n1 | tr -d '[:space:]' || true)
    suggestion=""
    if [[ "$clip" =~ ^https?://[^/]*linear\.app/[^/]+/issue/ || "$clip" =~ ^[A-Za-z][A-Za-z0-9]*-[0-9]+$ ]]; then
        suggestion=$clip
    fi
    set -o vi
    read -e -r -p "Ticket link, id, branch, or task${suggestion:+ [$suggestion]}: " ref || exit 0
    ref=${ref:-$suggestion}
    [[ -n "$ref" ]] || exit 0
    parse_ticket "$ref"
    if [[ -n "$ticket_id" && -f "$cache_dir/team-repos" ]]; then
        team_repo=$(awk -F'\t' -v t="${ticket_id%%-*}" '$1 == t { r = $2 } END { print r }' "$cache_dir/team-repos")
    fi
    project=$(pick_project "$team_repo") || exit 0
    [[ -n "$project" ]] || exit 0
    # Free text is a task: keep it as the title and first prompt, with the slug as the branch.
    if [[ -z "$ticket_id" ]] && ! git check-ref-format --branch "$ref" >/dev/null 2>&1; then
        cmd_start "$ref" --project "$project" --title "$ref"
    else
        cmd_start "$ref" --project "$project"
    fi
}

cmd_open() {
    local dir=${1:-$PWD} branch slug base pr_json="" links id url title choice
    git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || die "$dir is not a git checkout"
    branch=$(git -C "$dir" symbolic-ref --short -q HEAD || true)
    slug=$(git -C "$dir" remote get-url origin 2>/dev/null | sed -E 's#\.git$##' | sed -nE 's#^.*github\.com[:/]([^/]+/[^/]+)$#\1#p' || true)
    base=$(git -C "$dir" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)
    [[ "$branch" != "${base:-main}" ]] || branch=""
    if [[ -n "$branch" ]] && command -v gh >/dev/null 2>&1; then
        pr_json=$(cd "$dir" && gh pr view --json number,url,title,statusCheckRollup 2>/dev/null) || pr_json=""
    fi
    id=$(git -C "$dir" config --get "branch.$branch.linear-id" 2>/dev/null || true)
    url=$(git -C "$dir" config --get "branch.$branch.linear-url" 2>/dev/null || true)
    title=$(git -C "$dir" config --get "branch.$branch.linear-title" 2>/dev/null || true)
    if [[ -z "$id" && "${branch##*/}" =~ ^([A-Za-z][A-Za-z0-9]*)-([0-9]+)(-|$) ]]; then
        local org
        org=$(cat "$cache_dir/linear-org" 2>/dev/null || true)
        id="$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]')-${BASH_REMATCH[2]}"
        [[ -z "$org" ]] || url="https://linear.app/$org/issue/$id"
    fi

    links=$( {
        [[ -z "$url" ]] || printf '%s  %s  %s\t%s\n' "$linear_glyph" "$id" "$title" "$url"
        if [[ -n "$pr_json" ]]; then
            jq -r '.url as $u
                | "PR  #\(.number)  \(.title)\t\($u)",
                  "    changed files\t\($u)/files",
                  "    checks\t\($u)/checks",
                  (.statusCheckRollup[]?
                    | select((if (.conclusion // "") != "" then .conclusion else (.state // "") end | ascii_upcase) as $c
                        | ["FAILURE", "ERROR", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE"] | index($c))
                    | "    failing: \(.name // .context)\t\(.detailsUrl // .targetUrl // "")")' <<<"$pr_json"
        elif [[ -n "$slug" && -n "$branch" ]]; then
            printf 'compare %s\thttps://github.com/%s/compare/%s...%s\n' "$branch" "$slug" "${base:-main}" "$branch"
        fi
        [[ -z "$slug" || -z "$branch" ]] || printf 'branch %s\thttps://github.com/%s/tree/%s\n' "$branch" "$slug" "$branch"
    } | awk -F'\t' 'NF == 2 && $2 != "" && !seen[$2]++')

    [[ -n "$links" ]] || { note "no ticket, PR or GitHub branch for $dir"; sleep 2; exit 1; }
    if [[ $(wc -l <<<"$links") -eq 1 ]] || ! command -v fzf >/dev/null 2>&1; then
        choice=$(head -n1 <<<"$links")
    else
        choice=$(fzf --delimiter=$'\t' --with-nth=1 --prompt='Open > ' <<<"$links") || exit 0
    fi
    open "${choice#*$'\t'}"
}

cmd_project() {
    local dir=${1:-}
    if [[ -z "$dir" ]]; then
        [[ -n "${HERDR_TASK_PROJECT_ROOTS:-}" ]] || die "set HERDR_TASK_PROJECT_ROOTS"
        command -v fzf >/dev/null 2>&1 || die "fzf is required"
        local -a roots
        IFS=: read -r -a roots <<<"$HERDR_TASK_PROJECT_ROOTS"
        dir=$(find "${roots[@]}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort | fzf --prompt='Project > ') || exit 0
    fi
    dir=$(cd "$dir" && pwd -P)
    open_session "$(basename "$dir")" "$dir"
}

# ---- review, ship, prs, prune, agent, scrollback ------------------------------------------

# Where errors go (error_mode, set per command). Popups (prs, prune, scrollback) run in a
# terminal: wait for a key so the message can be read. review, ship and agent run from Rex's
# config with no terminal: the message opens in a small floating pane of error_session.
error_session=""

# notice <text>: show a message the user must be able to read, per error_mode.
notice() {
    local text=$1 cmd lua
    case "$error_mode" in
        tty) printf 'Press a key to close ' >&2; read -r -n1 -s _ </dev/tty || true ;;
        layer)
            [[ -n "$error_session" ]] || return 0
            cmd="printf '%s\\n\\nPress a key to close.' $(printf '%q' "$text"); read -rsk1"
            lua=$(jq -rn --arg c "$cmd" '"rex.session.new_layer{ bounds = { 0.15, 0.4, 0.7, 0.2 }, focus = true, layout = rex.layout.block{ flavor = \"com.superlogical.terminal.shell\", options = { command = { \"zsh\", \"-c\", " + ($c | @json) + " } } } }"')
            "$rex_bin" "do" -s "$error_session" -e "$lua" >/dev/null 2>&1 || true ;;
    esac
}

# herdr-task with the private shell config (HERDR_TASK_PROJECT_ROOTS), as the popups run it.
herdr_task() {
    zsh -c 'source ~/.secrets.zshrc 2>/dev/null; exec ~/bin/herdr-task "$@"' herdr-task "$@"
}
# task_json <args>: herdr-task's stdout; on failure die with its last stderr line.
task_json() {
    local out err why
    err=$(mktemp)
    if out=$(herdr_task "$@" 2>"$err"); then
        rm -f "$err"
        printf '%s' "$out"
        return 0
    fi
    why=$(tail -n1 "$err" | sed 's/^herdr-task: //')
    rm -f "$err"
    die "${why:-herdr-task $1 failed}"
}

# block_cwd <session> <block>: the block's foreground working directory.
block_cwd() {
    "$rex_bin" block call -s "$1" -b "$2" process 2>/dev/null | jq -r '.foreground.cwd // .child.cwd // empty'
}

# is_agent <session> <block>: the block's foreground process is Claude or Codex.
is_agent() {
    "$rex_bin" block call -s "$1" -b "$2" process 2>/dev/null | jq -e '
        (.foreground // .child // {}) as $p
        | [$p.name, $p.argv0, $p.invoked_path, $p.path] | map((. // "") | split("/") | last)
        | any(. == "claude" or . == "codex")' >/dev/null 2>&1
}

# terminal_blocks <session>: "block<TAB>label" for each terminal block, in layout order.
terminal_blocks() {
    "$rex_bin" block ls -s "$1" --json 2>/dev/null | jq -r '.blocks[] | select(.creator_name == "com.superlogical.terminal") | [.block_id, (.label // "")] | @tsv'
}

# focused_block <session>: the focused block of the session's active window.
focused_block() {
    "$rex_bin" session inspect ${1:+"$1"} --json 2>/dev/null | jq -r '.active_window_id as $w | first(.windows[] | select(.window_id == $w) | .focused_block_id) // empty'
}

cmd_review() {
    local session=${1:-} block=${2:-} cwd plan repo prompt codex created second
    [[ -n "$session" && -n "$block" ]] || die "usage: rex-task review SESSION BLOCK"
    error_mode="layer" error_session=$session
    cwd=$(block_cwd "$session" "$block")
    [[ -n "$cwd" ]] || die "no working directory for the focused pane"
    if terminal_blocks "$session" | cut -f2 | grep -qx reviewer; then
        die "reviewers for this session are still open; close them (ctrl+b>x) for a fresh review"
    fi
    plan=$(task_json review-plan --cwd "$cwd")
    repo=$(jq -r '.repo' <<<"$plan")
    prompt=$(jq -r '.prompt' <<<"$plan")
    codex=$(jq -r '.codex // empty' <<<"$plan")
    "$rex_bin" block ls -s "$session" --json 2>/dev/null | jq -e --arg b "$block" 'any(.blocks[]; .block_id == $b)' >/dev/null \
        || die "the task's pane closed before the reviewers could open"
    created=$("$rex_bin" split -s "$session" -b "$block" --split=right --focus=false -c "$repo" --label reviewer --json -- claude "$prompt") \
        || die "could not open the Claude reviewer"
    second=$(jq -r '.block_ids[0] // empty' <<<"$created")
    [[ -n "$second" ]] || die "split did not report the new block"
    if [[ -n "$codex" ]]; then
        "$rex_bin" split -s "$session" -b "$second" --split=below --focus=false -c "$repo" --label reviewer -- zsh -lc "$codex; exec zsh" >/dev/null
    else
        "$rex_bin" split -s "$session" -b "$second" --split=below --focus=false -c "$repo" --label reviewer -- codex "$prompt" >/dev/null
    fi || die "could not open the Codex reviewer"
    "$rex_bin" focus -s "$session" "$block" >/dev/null 2>&1 || true
    note "reviewing $(jq -r '.branch' <<<"$plan") against $(jq -r '.base' <<<"$plan")"
}

cmd_ship() {
    local session=${1:-} block=${2:-} agent="" id label cwd out prompt
    [[ -n "$session" && -n "$block" ]] || die "usage: rex-task ship SESSION BLOCK"
    error_mode="layer" error_session=$session
    if is_agent "$session" "$block"; then
        agent=$block
    else
        while IFS=$'\t' read -r id label; do
            [[ -n "$id" && "$label" != reviewer ]] || continue
            if is_agent "$session" "$id"; then agent=$id; break; fi
        done < <(terminal_blocks "$session")
    fi
    if [[ -n "$agent" ]]; then
        prompt=$(task_json ship-prompt)
        "$rex_bin" send -s "$session" -b "$agent" "$prompt" >/dev/null || die "could not send to the agent"
        "$rex_bin" send-key -s "$session" -b "$agent" enter >/dev/null || die "could not press enter in the agent"
        note "asked the agent to ship"
        return 0
    fi
    cwd=$(block_cwd "$session" "$block")
    [[ -n "$cwd" ]] || die "no agent and no working directory to ship"
    out=$(task_json ship-direct --cwd "$cwd")
    note "shipped $(jq -r '.branch' <<<"$out")"
    # No terminal to print to when run from the config: show the PR link in a floating pane.
    error_mode="layer"
    notice "Shipped $(jq -r '.branch' <<<"$out"): $(jq -r '.pr // "pushed"' <<<"$out")"
}

# ---- prs ----

# The GitHub search behind each list, flattened to TSV: display, url, repo, number, branch,
# fork (true/false), title. Mirrors herdr-app/mods/task-prs.
pr_rows() {
    local kind=$1 slug=${2:-} search
    case "$kind" in
        mine) search='is:pr is:open author:@me archived:false sort:updated-desc' ;;
        review) search='is:pr is:open review-requested:@me archived:false sort:updated-desc' ;;
        repo) [[ -n "$slug" && "$slug" != none ]] || return 0; search="is:pr is:open repo:$slug sort:updated-desc" ;;
        *) return 1 ;;
    esac
    # shellcheck disable=SC2016  # GraphQL and jq programs, not shell
    gh api graphql -f query='query($q: String!) { s: search(query: $q, type: ISSUE, first: 25) { nodes { ... on PullRequest {
        number title url isDraft headRefName isCrossRepository author { login } reviewDecision repository { nameWithOwner }
        commits(last: 1) { nodes { commit { statusCheckRollup { state } } } } } } } }' -f q="$search" --jq '
        .data.s.nodes[] | select(.url) | . as $n
        | ($n.commits.nodes[0].commit.statusCheckRollup.state // "") as $ci
        | (if $ci == "SUCCESS" then "ok  " elif $ci == "FAILURE" or $ci == "ERROR" then "fail" elif $ci != "" then "... " else "    " end) as $c
        | ([ (if $n.isDraft then "draft" else empty end),
             ({APPROVED: "approved", CHANGES_REQUESTED: "changes"}[$n.reviewDecision // ""] // empty) ] | join(" ")) as $tags
        | ($n.title | gsub("[\t\n]"; " ")) as $title
        | [ "\($c) #\($n.number)  \($title)  [\($n.repository.nameWithOwner)] \($n.author.login // "")  \($tags)",
            $n.url, $n.repository.nameWithOwner, ($n.number | tostring), $n.headRefName, ($n.isCrossRepository | tostring), $title ] | @tsv'
}

repo_slug() {
    git -C "${1:-.}" remote get-url origin 2>/dev/null | sed -E 's#\.git$##' | sed -nE 's#^.*github\.com[:/]([^/]+/[^/]+)$#\1#p' || true
}

# local_repo <owner/name>: the checkout among the project roots whose origin is that repo.
local_repo() {
    local want name p projects
    want=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    name=${want##*/}
    projects=$(task_json projects | jq -r '.projects[]')
    while IFS= read -r p; do
        [[ -n "$p" ]] || continue
        [[ $(basename "$p" | tr '[:upper:]' '[:lower:]') == "$name" ]] || continue
        if [[ $(repo_slug "$p" | tr '[:upper:]' '[:lower:]') == "$want" ]]; then
            printf '%s\n' "$p"
            return 0
        fi
    done <<<"$projects"
    return 1
}

pr_worktree() {
    local repo=$1 number=$2 branch=$3 fork=$4 title=$5 checkout prepared path
    checkout=$(local_repo "$repo") || die "no checkout of $repo under the project roots"
    if [[ "$fork" == true ]]; then
        # A fork's branch is not on origin. Once fetched, pr-<n> is kept as it is (it may be
        # checked out or hold review commits): prepare reopens it.
        branch="pr-$number"
        if ! git -C "$checkout" show-ref -q --verify "refs/heads/$branch"; then
            git -C "$checkout" fetch -q origin "pull/$number/head:$branch" || die "git fetch pull/$number/head failed"
        fi
    fi
    prepared=$(task_json prepare "$branch" --project "$checkout" --title "$title" --agent none)
    path=$(jq -r '.path' <<<"$prepared")
    open_session "$(printf '#%s %s' "$number" "$title" | cut -c1-48)" "$path"
}

cmd_prs() {
    local dir=${1:-$PWD} slug self selection key row url repo number branch fork title dependency
    error_mode="tty"
    for dependency in gh fzf; do command -v "$dependency" >/dev/null 2>&1 || die "$dependency is required"; done
    slug=$(repo_slug "$dir")
    self=$(printf '%q' "$0")
    selection=$(pr_rows mine | fzf --delimiter=$'\t' --with-nth=1 --prompt='Mine > ' --expect=ctrl-y,ctrl-w \
        --header='alt-1 mine  alt-2 review  alt-3 this repo   enter open  ctrl-y copy  ctrl-w worktree' \
        --bind "alt-1:reload($self prs-list mine)+change-prompt(Mine > )" \
        --bind "alt-2:reload($self prs-list review)+change-prompt(Review > )" \
        --bind "alt-3:reload($self prs-list repo ${slug:-none})+change-prompt(${slug##*/} > )") || exit 0
    key=$(sed -n 1p <<<"$selection")
    row=$(sed -n 2p <<<"$selection")
    [[ -n "$row" ]] || exit 0
    IFS=$'\t' read -r _ url repo number branch fork title <<<"$row"
    case "$key" in
        ctrl-y) printf '%s' "$url" | pbcopy; note "copied $url"; sleep 1 ;;
        ctrl-w) pr_worktree "$repo" "$number" "$branch" "$fork" "$title" ;;
        *) open "$url" ;;
    esac
}

# ---- prune ----

cmd_prune() {
    local dir=${1:-$PWD} plan repo count answer check result id d killed=0 own="" path removed_json='[]' kept_json
    local -a paths=() removable=() real_removable=()
    local tilde='~'
    error_mode="tty"
    plan=$(task_json prunable --cwd "$dir")
    repo=$(jq -r '.repo' <<<"$plan")
    count=$(jq '[.worktrees[] | select(.remove)] | length' <<<"$plan")
    printf 'Worktrees of %s\n\n' "${repo/#"$HOME"/$tilde}"
    jq -r '.worktrees[] | "\(if .remove then "remove" else "keep  " end)  \(.branch // "(detached)")  \(.verdict)\n        \(.path)"' <<<"$plan"
    if [[ "$count" -eq 0 ]]; then
        printf '\nNothing to remove. Press a key to close '
        read -r -n1 -s _ </dev/tty || true
        return 0
    fi
    printf '\nRemove %s worktree(s)? Branches are kept. [y/N] ' "$count"
    read -r answer </dev/tty || answer=""
    [[ "$answer" == [yY] ]] || { note "aborted"; sleep 1; return 0; }
    while IFS= read -r path; do paths+=("$path"); done < <(jq -r '.worktrees[] | select(.remove) | .path' <<<"$plan")
    # Check first, so a worktree that is kept never loses its session.
    check=$(task_json prune-remove --cwd "$repo" --check "${paths[@]}")
    kept_json=$(jq -c '.kept // []' <<<"$check")
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        removable+=("$path")
        real_removable+=("$(cd "$path" 2>/dev/null && pwd -P || printf '%s' "$path")")
    done < <(jq -r '.removable[]?' <<<"$check")
    if [[ ${#removable[@]} -gt 0 ]]; then
        # A session working in a removable worktree would come back: kill those, this one last.
        while read -r id; do
            [[ -n "$id" ]] || continue
            d=$(session_dir "$id")
            d=$(cd "$d" 2>/dev/null && pwd -P || printf '%s' "$d")
            for path in "${real_removable[@]}"; do
                if [[ "$d" == "$path" || "$d" == "$path"/* ]]; then
                    if [[ "$id" == "${REX_SESSION:-}" ]]; then
                        own=$id
                    elif "$rex_bin" kill "$id" >/dev/null 2>&1; then
                        killed=$((killed + 1))
                    fi
                    break
                fi
            done
        done < <("$rex_bin" ls --json | jq -r '.sessions[].session_id')
        result=$(task_json prune-remove --cwd "$repo" "${removable[@]}")
        removed_json=$(jq -c '.removed // []' <<<"$result")
        kept_json=$(jq -c --argjson k "$kept_json" '$k + (.kept // [])' <<<"$result")
    fi
    printf '\nRemoved %s worktree(s), closed %s session(s)\n' "$(jq 'length' <<<"$removed_json")" "$((killed + (${#own} > 0 ? 1 : 0)))"
    jq -r '.[] | "  removed \(.)"' <<<"$removed_json"
    jq -r '.[] | "  kept \(.path): \(.why)"' <<<"$kept_json"
    printf '\nPress a key to close '
    read -r -n1 -s _ </dev/tty || true
    [[ -z "$own" ]] || "$rex_bin" kill "$own" >/dev/null 2>&1 || true
}

# ---- agent ----

# agent_pick next|prev|N <session> <block>: prints "session<TAB>block" of the agent to go to.
# next and prev start from the given block (default: the focused block of the session) and
# wrap around across all sessions, in session and layout order.
agent_pick() {
    local target=$1 cur_session=${2:-} cur_block=${3:-} sid id label idx count pos cur=-1 step=1 i
    local -a rows=() flags=()
    [[ -n "$cur_session" ]] || cur_session=$("$rex_bin" ls --json | jq -r '.sessions[0].session_id // empty')
    [[ -n "$cur_block" ]] || cur_block=$(focused_block "$cur_session")
    while read -r sid; do
        [[ -n "$sid" ]] || continue
        while IFS=$'\t' read -r id label; do
            [[ -n "$id" ]] || continue
            rows+=("$sid"$'\t'"$id")
            if is_agent "$sid" "$id"; then flags+=(1); else flags+=(0); fi
        done < <(terminal_blocks "$sid")
    done < <("$rex_bin" ls --json | jq -r '.sessions[].session_id')
    count=${#rows[@]}
    [[ $count -gt 0 ]] || return 1
    if [[ "$target" =~ ^[0-9]+$ ]]; then
        pos=0
        for ((idx = 0; idx < count; idx++)); do
            [[ "${flags[$idx]}" == 1 ]] || continue
            pos=$((pos + 1))
            if [[ $pos -eq $target ]]; then printf '%s\n' "${rows[$idx]}"; return 0; fi
        done
        return 1
    fi
    for ((idx = 0; idx < count; idx++)); do
        if [[ "${rows[$idx]}" == "$cur_session"$'\t'"$cur_block" ]]; then cur=$idx; break; fi
    done
    [[ "$target" == prev ]] && step=-1
    if [[ $cur -lt 0 ]]; then   # unknown focus: start before the first (next) or after the last (prev)
        if [[ "$target" == prev ]]; then cur=0; else cur=$((count - 1)); fi
    fi
    i=$cur
    for ((idx = 0; idx < count; idx++)); do
        i=$(( (i + step + count) % count ))
        if [[ "${flags[$i]}" == 1 ]]; then printf '%s\n' "${rows[$i]}"; return 0; fi
    done
    return 1
}

# REX_TASK_DRY=1 prints the pick instead of going there.
cmd_agent() {
    local target=${1:-} picked session block
    [[ "$target" == next || "$target" == prev || "$target" =~ ^[1-9][0-9]*$ ]] || die "usage: rex-task agent next|prev|N [SESSION BLOCK]"
    error_mode="layer" error_session=${2:-${REX_SESSION:-}}
    picked=$(agent_pick "$target" "${2:-${REX_SESSION:-}}" "${3:-${REX_BLOCK:-}}") || picked=""
    [[ -n "$picked" ]] || die "no matching agent terminal (Claude or Codex)"
    session=${picked%%$'\t'*}
    block=${picked#*$'\t'}
    if [[ "${REX_TASK_DRY:-}" == 1 ]]; then
        printf '%s\t%s\n' "$session" "$block"
        return 0
    fi
    show_session "$session" "$session"
    "$rex_bin" focus -s "$session" "$block" >/dev/null 2>&1 || die "could not focus the agent"
}

# ---- scrollback ----

cmd_scrollback() {
    local session=${1:-} block=${2:-} file
    [[ -n "$session" && -n "$block" ]] || die "usage: rex-task scrollback SESSION BLOCK"
    error_mode="tty"
    file=$(mktemp "${TMPDIR:-/tmp}/rex-scrollback.XXXXXX")
    trap 'rm -f "$file"' EXIT
    "$rex_bin" capture -s "$session" -b "$block" >"$file" || die "could not capture the pane"
    # shellcheck disable=SC2086  # EDITOR may carry arguments, e.g. "code -w"
    ${EDITOR:-nvim} + "$file"
}

case "${1:-}" in
    "") cmd_interactive ;;
    start) shift; cmd_start "$@" ;;
    open) shift; cmd_open "$@" ;;
    project) shift; cmd_project "$@" ;;
    review) shift; cmd_review "$@" ;;
    ship) shift; cmd_ship "$@" ;;
    prs) shift; cmd_prs "$@" ;;
    prs-list) shift; pr_rows "$@" ;;   # fzf's reload command
    prune) shift; cmd_prune "$@" ;;
    agent) shift; cmd_agent "$@" ;;
    scrollback) shift; cmd_scrollback "$@" ;;
    -h|--help) awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$0" ;;
    *) die "unknown command: $1 (see rex-task --help)" ;;
esac
