#!/usr/bin/env bash

set -euo pipefail

herdr_root=$(cd "$(dirname "$0")" && pwd)
dotfiles_root=$(cd "$herdr_root/.." && pwd)
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/herdr"
config_file="$config_dir/config.toml"
config_source="$herdr_root/.config/herdr/config.toml"

if ! command -v herdr >/dev/null 2>&1; then
    if ! command -v brew >/dev/null 2>&1; then
        printf 'Homebrew is required to install Herdr.\n' >&2
        exit 1
    fi

    echo "Installing Herdr..."
    brew install herdr
fi

if [[ "$(uname -s)" == Darwin ]] && ! command -v terminal-notifier >/dev/null 2>&1; then
    brew install terminal-notifier
fi

mkdir -p "$config_dir" "$HOME/bin"

if [[ -L "$config_file" ]]; then
    rm "$config_file"
elif [[ -e "$config_file" ]]; then
    backup_file="$config_file.backup"
    if [[ -e "$backup_file" ]]; then
        printf 'Refusing to overwrite existing backup: %s\n' "$backup_file" >&2
        exit 1
    fi
    mv "$config_file" "$backup_file"
fi

ln -s "$config_source" "$config_file"
ln -nsf "$dotfiles_root/bin/herdr-sessionizer" "$HOME/bin/herdr-sessionizer"
ln -nsf "$dotfiles_root/bin/herdr-task" "$HOME/bin/herdr-task"
ln -nsf "$dotfiles_root/bin/herdr-status" "$HOME/bin/herdr-status"
# Vim-mode fzf defaults for the popups' pickers (also linked by ./setup for the shell).
mkdir -p "$HOME/.config/fzf"
ln -nsf "$dotfiles_root/fzf/fzfrc" "$HOME/.config/fzf/fzfrc"

herdr config check

for integration in claude codex devin pi; do
    if command -v "$integration" >/dev/null 2>&1; then
        herdr integration install "$integration"
    fi
done

# Sidebar plugin: agent logos, state spinners and the workspace > tab > agent tree.
# Its own setup step is never run; the rows are hand-merged in config.toml.
# A list of one, so another marketplace plugin is a one-word change.
# shellcheck disable=SC2043
for plugin in testy-cool/herdr-sidebar-config; do
    if ! herdr plugin list 2>/dev/null | grep -qi "${plugin##*/}"; then
        herdr plugin install --yes "$plugin"
    fi
done

# Worktree cleanup: removes a task worktree when its workspace closes, if the branch merged.
if ! herdr plugin list 2>/dev/null | grep -q 'dotfiles.worktree-cleanup'; then
    herdr plugin link "$herdr_root/plugins/worktree-cleanup"
fi

# Task plugin: review/ship actions (prefix+y, prefix+u) and Ctrl-click handlers for Linear and
# GitHub issue links and file:// links.
if ! herdr plugin list 2>/dev/null | grep -q 'dotfiles.task'; then
    herdr plugin link "$herdr_root/plugins/task"
fi

# The keymap in AGENTS.md and README.md must match config.toml; warn, never block setup.
"$herdr_root/check-keymap" || printf 'herdr: keymap docs are out of date (see above)\n' >&2

# The sidebar plugin draws logos from its own font (U+E1A0-U+E1AB, mapped in the Ghostty
# config). Copy it to the user font folder and pin the plugin to font mode; Ghostty needs a
# fresh launch to pick up a new font.
sidebar_plugin_config=$(herdr plugin config-dir testy-cool.herdr-sidebar 2>/dev/null || true)
if [[ -n "$sidebar_plugin_config" ]]; then
    mkdir -p "$sidebar_plugin_config"
    grep -q '^icons' "$sidebar_plugin_config/config.toml" 2>/dev/null \
        || printf 'icons = "font"\n' >> "$sidebar_plugin_config/config.toml"
    # Tabs take the conversation's title instead of the program or directory name.
    grep -q '^conversation_titles' "$sidebar_plugin_config/config.toml" 2>/dev/null \
        || printf 'conversation_titles = true\n' >> "$sidebar_plugin_config/config.toml"
fi
# The plugin is Python 3.11+ (tomllib) and runs with a fixed PATH (~/.local/bin, Homebrew,
# /usr/bin). macOS ships 3.9, and Homebrew's python@3.x keeps its unversioned python3 out of
# the bin directory, so a brew upgrade can leave the plugin without a usable python3 (the
# sidebar then silently stops updating). Expose Homebrew's python3 through ~/.local/bin.
if ! PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin" python3 -c 'import tomllib' 2>/dev/null; then
    brew_python=$(ls -d /opt/homebrew/opt/python@3.*/libexec/bin/python3 /usr/local/opt/python@3.*/libexec/bin/python3 2>/dev/null | sort -V | tail -n 1)
    if [[ -z "$brew_python" ]] && command -v brew >/dev/null 2>&1; then
        brew install python
        brew_python=$(ls -d /opt/homebrew/opt/python@3.*/libexec/bin/python3 /usr/local/opt/python@3.*/libexec/bin/python3 2>/dev/null | sort -V | tail -n 1)
    fi
    if [[ -n "$brew_python" ]]; then
        mkdir -p "$HOME/.local/bin"
        ln -sf "$brew_python" "$HOME/.local/bin/python3"
    else
        printf 'No Python 3.11+ found for the sidebar plugin; install one on PATH.\n' >&2
    fi
fi
if [[ "$(uname -s)" == Darwin ]]; then
    for font in "$HOME"/.config/herdr/plugins/github/testy-cool.herdr-sidebar-*/dist/HerdrSidebarLogos-Regular.ttf \
                "$dotfiles_root/herdr/fonts/HerdrTaskIcons-Regular.ttf"; do
        [[ -f "$font" ]] && cp -f "$font" "$HOME/Library/Fonts/"
    done
fi

echo "Herdr configuration installed."
